/* One look for every mode: spotlight.rasi carries theme, font, and matching. */
configuration {
  modi: "drun,run,window";
  show-icons: true;
  drun-display-format: "{name}";
  /* pkexec refuses a dead parent, and rofi exits after launching. sh waits;
     "|| :" keeps bash from exec'ing away. */
  run-command: "sh -c '\"$@\" || :' rofi-run {cmd}";
}
@theme "spotlight"
