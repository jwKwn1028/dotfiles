/* Every rofi mode shares one look. spotlight.rasi carries the theme, the
   font, and the drun matching/sorting options, so `rofi -show window` looks
   like `rofi -show drun` instead of falling back to a stock theme. */
configuration {
  modi: "drun,run,window";
  show-icons: true;
  drun-display-format: "{name}";
}
@theme "spotlight"
