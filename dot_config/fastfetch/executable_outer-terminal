#!/bin/sh

case ${1:-} in
  name | font) ;;
  *) echo "usage: ${0##*/} name|font" >&2; exit 2 ;;
esac

[ -n "${TMUX:-}" ] || exit 1
pid=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{client_pid}' 2>/dev/null)
[ -n "$pid" ] || exit 1

while [ "$pid" -gt 1 ] 2>/dev/null; do
  info=$(ps -o ppid= -o comm= -p "$pid" 2>/dev/null) || exit 1
  read -r ppid comm <<EOF
$info
EOF
  [ "${comm##*/}" = ghostty ] && break
  pid=$ppid
done
[ "$pid" -gt 1 ] 2>/dev/null || exit 1

case $comm in
  /*) exe=$comm ;;
  *) exe=$(readlink "/proc/$pid/exe" 2>/dev/null) ;;
esac
[ -x "$exe" ] || exe=ghostty

if [ "$1" = name ]; then
  version=$("$exe" --version 2>/dev/null | awk 'NR == 1 && $1 == "Ghostty" { print $2 }')
  multiplexer=$(tmux -V 2>/dev/null)
  echo "ghostty${version:+ $version}${multiplexer:+ ($multiplexer)}"
  exit 0
fi

"$exe" +show-config 2>/dev/null | awk -F ' = ' '
  $1 == "font-family" && $2 != "" { fam[++n] = $2 }
  $1 == "font-size" { size = $2 }
  END {
    if (!n) exit 1
    out = fam[1] (size != "" ? " (" size "pt)" : "")
    if (n > 1) out = out " / " fam[2]
    print out
  }'
