# Screen locker for the Niri desktop, replacing noctalia-shell's lockScreen.
# Reached from Mod+Alt+L, `session-menu lock`, and swayidle's handlers in
# dot_config/niri/cfg/autostart.kdl.
#
# Tokyo Night colours, which swaylock takes as RRGGBB with no leading '#'.
#
# `daemonize` is deliberately unset: call sites pass -f, and swayidle's
# before-sleep handler needs the lock surface up before swaylock detaches.

# Feedback while typing, without leaking the password length. The indicator is
# drawn by default but only once a key is pressed; idle-visible keeps it up, so
# a locked screen does not look like a blank one.
indicator-idle-visible
indicator-radius=90
indicator-thickness=8
indicator-caps-lock
show-failed-attempts
ignore-empty-password

font=NewComputerModernSans10
font-size=20

# Backdrop.
color=1a1b26

# Idle / typing / verifying / wrong, in that order.
inside-color=292d3ecc
inside-clear-color=292d3ecc
inside-caps-lock-color=292d3ecc
inside-ver-color=283457cc
inside-wrong-color=3b2b3ccc

ring-color=414868
ring-clear-color=7aa2f7
ring-caps-lock-color=e0af68
ring-ver-color=7aa2f7
ring-wrong-color=f7768e

line-color=1a1b26
line-clear-color=1a1b26
line-caps-lock-color=1a1b26
line-ver-color=1a1b26
line-wrong-color=1a1b26

key-hl-color=9ece6a
bs-hl-color=f7768e
caps-lock-key-hl-color=e0af68
caps-lock-bs-hl-color=f7768e
separator-color=00000000

text-color=c0caf5
text-clear-color=c0caf5
text-caps-lock-color=e0af68
text-ver-color=c0caf5
text-wrong-color=f7768e

layout-bg-color=292d3e
layout-border-color=292e42
layout-text-color=c0caf5
