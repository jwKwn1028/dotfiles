# Pure i3 session. No xfce4-panel; xfsettingsd for theming/cursor only, polybar
# for the bar.

set $mod Mod4
font pango:DejaVu Sans 10
focus_follows_mouse yes
focus_wrapping no
workspace_auto_back_and_forth yes

# Keep the pixel value in sync with NEW="pixel 1" in toggle-titles.sh.
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart

# Tokyo Night (Night)   border  bgcolor text    indicator child_border
client.focused          #86be43 #1a1b26 #c0caf5 #86be43   #86be43
client.unfocused        #16161e #16161e #565f89 #16161e   #16161e
client.focused_inactive #16161e #16161e #565f89 #16161e   #16161e

# --- launchers ---
bindsym $mod+Return           exec ghostty
bindsym $mod+Shift+Return     exec --no-startup-id xfce4-terminal
# bindsym Control+Mod1+t         exec --no-startup-id ghostty  # disabled so XFCE can use Ctrl+Alt+T
# $mod+d is XFWM-style tile-right, so rofi takes $mod+space.
bindsym $mod+space            exec --no-startup-id env XDG_CURRENT_DESKTOP=XFCE:i3 rofi -show drun -theme spotlight
bindsym $mod+Tab              exec --no-startup-id ~/.config/i3/focus-prev.sh
bindsym $mod+Shift+Tab        exec --no-startup-id rofi -show window
bindsym $mod+t                exec --no-startup-id thunar
bindsym $mod+p                exec --no-startup-id xfce4-display-settings --minimal
bindsym XF86Display           exec --no-startup-id xfce4-display-settings --minimal
bindsym $mod+Shift+p          exec --no-startup-id ~/.config/i3/display-setup.sh
bindsym Control+$mod+z        exec --no-startup-id zed
# bindsym Control+$mod+l        exec --no-startup-id xflock4  # reserved for numeric workspace navigation
bindsym Control+Mod1+p        exec --no-startup-id flatpak run com.super_productivity.SuperProductivity
# Ghostty's tab bar has no in-app toggle, so i3 drives it. Mod1+Shift+t is free
# in i3, XFCE, zsh, tmux and Ghostty's own defaults.
bindsym Mod1+Shift+t          exec --no-startup-id ~/.config/ghostty/toggle-tabbar.sh
# bindsym Control+$mod+h        exec --no-startup-id gtk-launch helium  # reserved for numeric workspace navigation
bindsym Control+Shift+z       exec --no-startup-id /usr/bin/flatpak run app.zen_browser.zen
bindsym --release Control+Mod1+Escape exec --no-startup-id /usr/bin/xkill
bindsym Control+Shift+Escape  exec --no-startup-id xfce4-taskmanager

# --- window management ---
bindsym $mod+Shift+q          kill
bindsym Mod1+F4               kill
bindsym Control+$mod+Shift+q  kill client
bindsym Control+Mod1+F4       kill client

# focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+m scratchpad show
# Moving and resizing both live in the $mod+r mode below.

# No split bindings: autotiling picks the direction on every focus change.
# tile-snap.sh and _snap-common.sh still issue `split h`/`split v` directly.
bindsym $mod+Shift+space floating toggle
# Recovery for a floating window no rule below caught, so it opened wherever the
# app asked -- possibly part-offscreen.
bindsym $mod+Shift+n move position center

# --- floating utility windows ---
# One alternation behind both criteria: an app sets class or instance, and two
# hand-copied lists drift. Anchored; `.*name.*` members opt back into substring
# matching. A window matching both just runs the same idempotent pair twice.
set $float_settings xfce4-power-manager-settings|nm-connection-editor|blueman-manager|blueman-adapters|pavucontrol|xfce4-display-settings|xfce4-settings-manager|xfce4-settings-editor|xfce4-appearance-settings|xfce4-mouse-settings|xfce4-keyboard-settings|xfce4-notifyd-config|xfce4-session-settings|thunar-settings|xfce4-taskmanager|system-config-printer|org\.gnome\.diskutility|gnome-disks|gufw|driver-manager|mintsources|mintreport|mintbackup|timeshift|timeshift-gtk|timeshift-launcher|users-admin|time-admin|fcitx5-configtool|fcitx-config-gtk3|fcitx5-config-qt|mintlocale|mintlocale-im|im-config|ibus-setup-hangul|light-locker-settings|onboard-settings|mugshot|menulibre|rofi-theme-selector|.*mintupdate.*
# Title fallbacks for the windows that set no useful class or instance.
set $float_titles .*xfce terminal settings.*|.*update manager.*|.*업데이트 매니저.*
for_window [class="(?i)^($float_settings)$"] floating enable, move position center
for_window [instance="(?i)^($float_settings)$"] floating enable, move position center
for_window [title="(?i)^($float_titles)$"] floating enable, move position center
for_window [class="(?i)^kakaotalk\.exe$"] floating enable, resize set 420 760, move position center
for_window [instance="(?i)^kakaotalk\.exe$"] floating enable, resize set 420 760, move position center

# --- XFWM-style snap-to-tile (window becomes floating in target rect) ---
bindsym $mod+a exec --no-startup-id ~/.config/i3/tile-snap.sh left
bindsym $mod+d exec --no-startup-id ~/.config/i3/tile-snap.sh right
bindsym $mod+w exec --no-startup-id ~/.config/i3/tile-snap.sh up
bindsym $mod+s exec --no-startup-id ~/.config/i3/tile-snap.sh down
bindsym $mod+q exec --no-startup-id ~/.config/i3/tile-snap.sh ul
bindsym $mod+e exec --no-startup-id ~/.config/i3/tile-snap.sh ur
bindsym $mod+z exec --no-startup-id ~/.config/i3/tile-snap.sh dl
bindsym $mod+c exec --no-startup-id ~/.config/i3/tile-snap.sh dr
bindsym --release $mod+u exec --no-startup-id ~/.config/i3/tile-snap.sh unsnap
bindsym $mod+f fullscreen toggle

# hjkl moves, Shift+hjkl resizes, Tab sends the window to the other monitor.
# Sticky -- no `mode "default"` on the actions. The mode name is the Polybar
# label, hence keys only; this comment is the only record of what they do.
#
# Container selection (a/A) was tried and removed: below three windows on a
# workspace there is no level above the window worth selecting.
set $mode_window hjkl / HJKL / Tab
mode "$mode_window" {
    bindsym h move left
    bindsym j move down
    bindsym k move up
    bindsym l move right
    bindsym Shift+h resize shrink width  10 px or 10 ppt
    bindsym Shift+j resize grow   height 10 px or 10 ppt
    bindsym Shift+k resize shrink height 10 px or 10 ppt
    bindsym Shift+l resize grow   width  10 px or 10 ppt
    # `next` cycles outputs, so it toggles across two monitors; no `prev` exists.
    # The trailing focus is required -- the move alone leaves focus behind.
    # Focus staying on the moved window is not asked for here: unset
    # mouse_warping (default `output`) warps the pointer onto it, beating
    # focus_follows_mouse. mouse_warping none would silently undo that.
    bindsym Tab move container to output next; focus output next
    # Both exits hide the bar again, but only if window-mode.sh raised it.
    bindsym Return exec --no-startup-id ~/.config/i3/window-mode.sh close, mode "default"
    bindsym Escape exec --no-startup-id ~/.config/i3/window-mode.sh close, mode "default"
}
bindsym $mod+r exec --no-startup-id ~/.config/i3/window-mode.sh open, mode "$mode_window"

# i3 control
bindsym $mod+Shift+c reload
bindsym $mod+Shift+i restart
bindsym $mod+Shift+e exec --no-startup-id "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# i3-resurrect session save/restore
bindsym --release Control+$mod+a exec --no-startup-id ~/.config/i3/i3-resurrect-save-all.sh
bindsym Control+$mod+r exec --no-startup-id ~/.config/i3/i3-resurrect-restore-all.sh
bindsym --release Control+$mod+b exec --no-startup-id ~/.config/i3/i3-resurrect-save-all-b.sh
bindsym Control+$mod+s exec --no-startup-id ~/.config/i3/i3-resurrect-restore-all-b.sh
bindsym --release Control+$mod+c exec --no-startup-id ~/.config/i3/i3-resurrect-save-all-c.sh
bindsym Control+$mod+t exec --no-startup-id ~/.config/i3/i3-resurrect-restore-all-c.sh

# --- workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

workspace $ws1  output primary
workspace $ws2  output primary
workspace $ws3  output primary
workspace $ws4  output primary
workspace $ws5  output primary
workspace $ws6  output primary
# By keyword, not output name: the old names are stale (external is
# DisplayPort-1), so `nonprimary` was already carrying these, and it is portable.
workspace $ws7  output nonprimary
workspace $ws8  output nonprimary
workspace $ws9  output nonprimary
workspace $ws10 output nonprimary

bindsym $mod+1 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 1
bindsym $mod+2 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 2
bindsym $mod+3 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 3
bindsym $mod+4 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 4
bindsym $mod+5 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 5
bindsym $mod+6 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 6
bindsym $mod+7 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 7
bindsym $mod+8 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 8
bindsym $mod+9 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 9
bindsym $mod+0 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 10
bindsym $mod+Mod1+1 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 1
bindsym $mod+Mod1+2 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 2
bindsym $mod+Mod1+3 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 3
bindsym $mod+Mod1+4 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 4
bindsym $mod+Mod1+5 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 5
bindsym $mod+Mod1+6 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 6
bindsym $mod+Mod1+7 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 7
bindsym $mod+Mod1+8 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 8
bindsym $mod+Mod1+9 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 9
bindsym $mod+Mod1+0 exec --no-startup-id ~/.config/i3/workspace-action.sh switch 10
bindsym Control+Mod1+1 workspace $ws1
bindsym Control+Mod1+2 workspace $ws2
bindsym Control+Mod1+3 workspace $ws3
bindsym Control+Mod1+4 workspace $ws4
bindsym Control+Mod1+5 workspace $ws5
bindsym Control+Mod1+6 workspace $ws6
bindsym Control+Mod1+7 workspace $ws7
bindsym Control+Mod1+8 workspace $ws8
bindsym Control+Mod1+9 workspace $ws9
bindsym Control+Mod1+0 workspace $ws10

# Keycodes, so a shifted number-row move does not depend on the layout.
bindcode $mod+Shift+10 exec --no-startup-id ~/.config/i3/workspace-action.sh move 1
bindcode $mod+Shift+11 exec --no-startup-id ~/.config/i3/workspace-action.sh move 2
bindcode $mod+Shift+12 exec --no-startup-id ~/.config/i3/workspace-action.sh move 3
bindcode $mod+Shift+13 exec --no-startup-id ~/.config/i3/workspace-action.sh move 4
bindcode $mod+Shift+14 exec --no-startup-id ~/.config/i3/workspace-action.sh move 5
bindcode $mod+Shift+15 exec --no-startup-id ~/.config/i3/workspace-action.sh move 6
bindcode $mod+Shift+16 exec --no-startup-id ~/.config/i3/workspace-action.sh move 7
bindcode $mod+Shift+17 exec --no-startup-id ~/.config/i3/workspace-action.sh move 8
bindcode $mod+Shift+18 exec --no-startup-id ~/.config/i3/workspace-action.sh move 9
bindcode $mod+Shift+19 exec --no-startup-id ~/.config/i3/workspace-action.sh move 10

# Super+X, then 1-0 for one workspace or Shift+K for every window. Polybar is
# shown while choosing. Return, Escape, and the all-window kill restore the
# bar's prior visibility; only a number key leaves it up, to show the workspace
# it just emptied.
mode "kill workspace" {
    bindsym 1 [workspace=$ws1] kill, mode "default"
    bindsym 2 [workspace=$ws2] kill, mode "default"
    bindsym 3 [workspace=$ws3] kill, mode "default"
    bindsym 4 [workspace=$ws4] kill, mode "default"
    bindsym 5 [workspace=$ws5] kill, mode "default"
    bindsym 6 [workspace=$ws6] kill, mode "default"
    bindsym 7 [workspace=$ws7] kill, mode "default"
    bindsym 8 [workspace=$ws8] kill, mode "default"
    bindsym 9 [workspace=$ws9] kill, mode "default"
    bindsym 0 [workspace=$ws10] kill, mode "default"
    bindsym Shift+k exec --no-startup-id ~/.config/i3/kill-all-windows.sh
    bindsym Return exec --no-startup-id ~/.config/i3/kill-workspace-mode.sh close, mode "default"
    bindsym Escape exec --no-startup-id ~/.config/i3/kill-workspace-mode.sh close, mode "default"
}
bindsym $mod+x exec --no-startup-id ~/.config/i3/kill-workspace-mode.sh open

bindsym $mod+Mod1+h exec --no-startup-id ~/.config/i3/workspace-action.sh prev
bindsym $mod+Mod1+l exec --no-startup-id ~/.config/i3/workspace-action.sh next
bindsym Control+$mod+h exec --no-startup-id ~/.config/i3/workspace-action.sh relative -1
bindsym Control+$mod+l exec --no-startup-id ~/.config/i3/workspace-action.sh relative 1
bindsym $mod+Shift+h exec --no-startup-id ~/.config/i3/workspace-action.sh move-relative -1
bindsym $mod+Shift+l exec --no-startup-id ~/.config/i3/workspace-action.sh move-relative 1

# --- media / brightness / screenshot ---
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@ toggle
bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym Print                 exec --no-startup-id flameshot gui
bindsym Shift+Print           exec --no-startup-id flameshot gui
bindsym Mod1+Print            exec --no-startup-id flameshot gui
bindsym Shift+$mod+s          exec --no-startup-id flameshot gui

# --- bar: polybar ---
bindsym $mod+Shift+b exec --no-startup-id ~/.config/i3/toggle-polybar-resnap.sh

# Keyboard cursor over polybar's modules; see bar-nav.sh. Mode name is a literal
# single space so polybar renders no text, and literal because i3 keeps the
# quotes inside a `set` value.
bindsym $mod+b exec --no-startup-id ~/.config/i3/bar-nav.sh open, mode " "
mode " " {
    bindsym h     exec --no-startup-id ~/.config/i3/bar-nav.sh prev
    bindsym l     exec --no-startup-id ~/.config/i3/bar-nav.sh next
    bindsym Left  exec --no-startup-id ~/.config/i3/bar-nav.sh prev
    bindsym Right exec --no-startup-id ~/.config/i3/bar-nav.sh next
    bindsym j     exec --no-startup-id ~/.config/i3/bar-nav.sh down
    bindsym k     exec --no-startup-id ~/.config/i3/bar-nav.sh up
    bindsym Down  exec --no-startup-id ~/.config/i3/bar-nav.sh down
    bindsym Up    exec --no-startup-id ~/.config/i3/bar-nav.sh up
    # No `mode "default"`: the script exits the mode itself, and only on a stop
    # that opens a window.
    bindsym Return       exec --no-startup-id ~/.config/i3/bar-nav.sh click
    bindsym Shift+Return exec --no-startup-id ~/.config/i3/bar-nav.sh click-right
    bindsym Escape exec --no-startup-id ~/.config/i3/bar-nav.sh close, mode "default"
}

# --- toggle window title bars ---
bindsym $mod+Shift+t exec --no-startup-id ~/.config/i3/toggle-titles-resnap.sh

# --- show desktop ---
bindsym $mod+m exec --no-startup-id ~/.config/i3/show-desktop.sh
bindsym $mod+Control+m move scratchpad
# --- autostart ---
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=secrets
exec_always --no-startup-id sh -c 'pgrep -u "$USER" polkit-gnome >/dev/null || /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &'
exec_always --no-startup-id sh -c 'pkill -f "bash .*/focus-tracker\.sh$"; setsid ~/.config/i3/focus-tracker.sh </dev/null >/dev/null 2>&1 &'
exec_always --no-startup-id sh -c 'pkill -f "bash .*/snap-watcher\.sh$"; setsid ~/.config/i3/snap-watcher.sh </dev/null >/dev/null 2>&1 &'
exec_always --no-startup-id sh -c 'pkill -f "bash .*/kakaotalk-float-watcher\.sh$"; setsid ~/.config/i3/kakaotalk-float-watcher.sh </dev/null >/dev/null 2>&1 &'
# Runs display-setup.sh on a real hotplug, keyed on the connected-output set --
# its own xrandr calls are RandR changes too, so raw events would loop.
exec_always --no-startup-id sh -c 'pkill -f "bash .*/randr-hotplug\.sh$"; setsid ~/.config/i3/randr-hotplug.sh </dev/null >/dev/null 2>&1 &'
exec_always --no-startup-id sh -c 'pkill -f "^/usr/bin/python3 .*/super-polybar-listener\.py$"; exec /usr/bin/python3 ~/.config/i3/super-polybar-listener.py'
exec_always --no-startup-id sh -c 'pkill -f "^/usr/bin/python3 .*/autotiling"; exec ~/.local/bin/autotiling --limit 6'
# -d until the idle-tiling bug is caught; decisions land in ~/.xsession-errors.
# pkill pattern omits `$` so it still matches with args.
exec_always --no-startup-id sh -c 'pkill -f "^/usr/bin/python3 .*/overflow-watcher\.py"; exec /usr/bin/python3 ~/.config/i3/overflow-watcher.py -d'
exec_always --no-startup-id sh -c 'pkill -f "^/usr/bin/python3 .*/top-edge-peek\.py$"; exec /usr/bin/python3 ~/.config/i3/top-edge-peek.py'
exec --no-startup-id xrdb -merge ~/.Xresources
exec --no-startup-id xsetroot -cursor_name left_ptr
exec_always --no-startup-id /usr/bin/flock -n /tmp/disable-trackpoint-middle-click.lock ~/.local/bin/disable-trackpoint-middle-click
exec_always --no-startup-id ~/.local/bin/touchpad apply
# exec_always: the `pgrep ||` guard makes a re-run a no-op, so $mod+Shift+i
# revives a dead daemon -- picom especially, as Polybar's ARGB bar needs it.
exec_always --no-startup-id sh -c 'pgrep -x xfsettingsd          >/dev/null || xfsettingsd &'
exec_always --no-startup-id sh -c 'pgrep -x xfce4-power-manager >/dev/null || xfce4-power-manager &'
exec_always --no-startup-id sh -c 'pgrep -x picom               >/dev/null || picom -b'
exec_always --no-startup-id sh -c 'pgrep -x nm-applet           >/dev/null || nm-applet &'
exec_always --no-startup-id sh -c 'pgrep -x blueman-applet      >/dev/null || blueman-applet &'
# Dock Blueman after nm-applet so the tray order is Wi-Fi, then Bluetooth.
# Stays `exec`: launch.sh already restarts it once nm-applet has docked, and a
# second start racing that would break the order.
exec --no-startup-id sh -c 'sleep 2; pgrep -x blueman-tray >/dev/null || blueman-tray &'
exec_always --no-startup-id sh -c 'pgrep -x unclutter-xfixes    >/dev/null || unclutter-xfixes --timeout 3 &'
exec --no-startup-id dropbox start -i
# I3_RELOAD_TOAST flashes a toast once Polybar is back: "Welcome" on a login's
# first parse, "i3 reloaded" after. Only $mod+Shift+i reaches it -- i3 4.23 skips
# exec_always on $mod+Shift+c. Super+Shift+P calls the script without the
# variable, so a manual display refresh stays silent.
exec_always --no-startup-id env I3_RELOAD_TOAST=1 ~/.config/i3/display-setup.sh
# Guarded like the daemons above, not a bare exec: a dead xss-lock silently
# stops idle locking. $mod+Shift+i now revives it.
exec_always --no-startup-id sh -c 'pgrep -x xss-lock >/dev/null || xss-lock -- xflock4 &'
