    layout {
        gaps 16 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        // Was "transparent" so noctalia-shell's wallpaper layer could show
        // through. Nothing draws that layer now -- noctalia was configured
        // with disableWallpaper anyway -- so niri paints the desktop itself,
        // in the Tokyo Night background the launcher and notifications use.
        // For an image instead, run swaybg and set this back to
        // "transparent"; see CACHYOS_TRANSFER_GUIDE.md.
        background-color "#1a1b26"

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        struts {}
    }
