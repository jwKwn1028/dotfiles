#!/usr/bin/env bash
# Generated by chezmoi. The repository password is deliberately stored in a
# separate, unmanaged file so it can never enter the dotfiles repository.
{{- $resticMount := "/mnt/backup" -}}
{{- if hasKey . "resticMount" -}}
{{-   $resticMount = .resticMount -}}
{{- end }}

RESTIC_BACKUP_MOUNT={{ $resticMount | quote }}
RESTIC_REPOSITORY="${RESTIC_BACKUP_MOUNT%/}/restic/$(hostname -s)/home"
RESTIC_SYSTEM_REPOSITORY="${RESTIC_BACKUP_MOUNT%/}/restic/$(hostname -s)/system"
RESTIC_PASSWORD_FILE={{ joinPath .chezmoi.homeDir ".config/restic/password" | quote }}

# Privileged state worth preserving in addition to HOME. The wrapper skips
# paths that do not exist, rejects paths on another source filesystem, and
# prevents traversal into nested mounts.
RESTIC_SYSTEM_PATHS=(
    "/etc"
    "/root"
    "/usr/local"
    "/srv"
    "/var/www"
    "/var/mail"
    "/var/spool/cron"

    # Package-selection state without downloaded packages, indexes, or the
    # full dpkg metadata tree.
    "/var/lib/dpkg/status"
    "/var/lib/dpkg/diversions"
    "/var/lib/dpkg/statoverride"
    "/var/lib/apt/extended_states"
    "/var/lib/aptitude/pkgstates"

    # Small machine identity and pairing databases not stored under /etc.
    "/var/lib/AccountsService"
    "/var/lib/NetworkManager"
    "/var/lib/bluetooth"
    "/var/lib/boltd"
    "/var/lib/fprint"
    "/var/lib/tailscale"
)
