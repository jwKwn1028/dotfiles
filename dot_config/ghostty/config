# JuliaMono 15 ≈ the old NewComputerModernMono10 at 18 (larger x-height).
font-family = JuliaMono
font-family = NanumGothicCoding
font-family = Noto Sans CJK KR
# Icon glyph fallback only; text stays in JuliaMono.
font-family = Hack Nerd Font Mono
font-style = Regular
font-size = 15
font-feature = -calt, -liga, -dlig

# Delta, not a scale factor. Lands the cell at ~1.35em.
adjust-cell-height = 15%

# Matches xfce default-geometry 120x36
window-width = 120
window-height = 36
window-inherit-font-size = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

theme = TokyoNight Storm
# Match Helix's exact background (theme default is #24283b)
background = #292d3e

cursor-style = block
cursor-color = #86be43
cursor-text = #1d202f
cursor-style-blink = false

# Keeps ~/.tmux.conf's `terminal-overrides ",xterm-256color:RGB"` working.
term = xterm-256color

shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-terminfo

# Matches xfce font-allow-bold = false
font-style-bold = false
# No synthesized slant on the fallbacks; JuliaMono's real italic stays.
font-synthetic-style = no-italic

# No GTK header bar and no XFWM titlebar.
window-decoration = none
gtk-titlebar = false

# Tab bar only with 2+ tabs; i3/Polybar see one title per window regardless.
window-show-tab-bar = auto
# Alt+Shift+T (i3) rewrites this include and sends SIGUSR2; see toggle-tabbar.sh.
# Optional (`?`): local-only state, kept out of chezmoi.
config-file = ?tabbar-state.conf
# Equal-width tabs give fixed positions, matching the Alt+N goto_tab binds.
gtk-wide-tabs = true
gtk-toolbar-style = flat
# Thin title strip; see tabbar.css. Relative to this file's directory.
gtk-custom-css = tabbar.css

keybind = ctrl+enter=unbind
keybind = ctrl+0=set_font_size:15
keybind = ctrl+shift+minus=set_font_size:10

# Split navigation. Ctrl+Shift+J replaces Ghostty's write-screen-file default.
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
# Replaces Ghostty's default Ctrl+Tab next-tab.
keybind = ctrl+tab=goto_split:next

# Tabs on Alt, splits on Ctrl+Shift. Not plain Alt+H/L (zsh-helix-mode binds
# ^[h / ^[l) and not Super (i3 owns $mod+H/L for focus).
keybind = alt+shift+h=previous_tab
keybind = alt+shift+l=next_tab

scrollbar = never
# No "120x36" popup on every i3 resize
resize-overlay = never

mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true
confirm-close-surface = false
copy-on-select = clipboard
# Default discrete:3 felt slow vs Firefox/xfce4-terminal
mouse-scroll-multiplier = precision:3,discrete:5

# Silence everything, including terminal-triggered desktop notifications (OSC 9).
app-notifications = no-clipboard-copy,no-config-reload
bell-features = no-system,no-audio,no-attention,no-title,no-border
notify-on-command-finish = never
progress-style = false
desktop-notifications = false

unfocused-split-opacity = 1
focus-follows-mouse = true
