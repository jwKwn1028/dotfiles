# Font (JuliaMono Regular 15; was NewComputerModernMono10 at 18 — JuliaMono's
# x-height is ~28% larger, so 15 here reads about the same size on screen.)
font-family = JuliaMono
font-family = NanumGothicCoding
font-family = Noto Sans CJK KR
# Private-use glyph fallback for CLI icons; regular text stays in JuliaMono above.
font-family = Hack Nerd Font Mono
font-style = Regular
font-size = 15
font-feature = -calt, -liga, -dlig

# Typography breathing room. Adjustments here are DELTAS, not scale factors:
# 15% adds 15%, it does not set the value to 15% of the original.
# JuliaMono's hhea line box is 1.175em while its ASCII ink is ~0.95em
# (cap 0.725 + descender 0.225), leaving only 0.225em of slack. +15% takes
# the cell to ~1.35em, the usual comfortable terminal line height.
adjust-cell-height = 15%

# Initial window size in cells (matches xfce default-geometry 120x36)
window-width = 120
window-height = 36
window-padding-x = 8
window-padding-y = 8

# Split leftover pixels evenly instead of dumping them on right/bottom
window-padding-balance = true

# Built-in TokyoNight Storm (matches Helix tokyonight_storm palette/aesthetic)
theme = TokyoNight Storm

# Override: match Helix's exact background (theme default is #24283b)
background = #292d3e

# Keep the green block cursor from the xfce setup
cursor-style = block
cursor-color = #86be43
cursor-text = #1d202f

# Steady block, no pulse
cursor-style-blink = false

# tmux compatibility: your ~/.tmux.conf has `terminal-overrides ",xterm-256color:RGB"`,
# so set TERM=xterm-256color here to keep that override working without editing tmux.conf.
term = xterm-256color

# Shell integration (zsh auto-detected; this is explicit)
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Disable bold rendering (matches xfce font-allow-bold = false)
font-style-bold = false

# No faux-slanted fallbacks. JuliaMono ships a real italic and still uses it;
# this only stops synthesized slant on the CJK/Nerd fallbacks, which have none.
font-synthetic-style = no-italic

# Disable all window decorations: GTK header bar (tabs/controls panel)
# AND the XFWM server-side titlebar (minimize/maximize/close).
window-decoration = none

# Belt-and-suspenders: explicitly hide the GTK headerbar/tabstrip even
# when window-decoration would normally cover it.
gtk-titlebar = false

# Never show the tab bar, even with multiple tabs.
# Switch tabs via keybind (ctrl+shift+left/right) or the tab overview.
window-show-tab-bar = never

# Disable the default Ctrl+Enter fullscreen toggle.
keybind = ctrl+enter=unbind

# Vim-style split navigation. These intentionally stay at the Ghostty level
# so they work regardless of the program running in the focused split.
# Ctrl+Shift+J replaces Ghostty's default write-screen-file binding.
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Cycle through splits in creation order.
# This intentionally replaces Ghostty's default Ctrl+Tab next-tab binding.
keybind = ctrl+tab=goto_split:next

# Hide the scrollbar (still scrollable via wheel/keybinds)
scrollbar = never

# No "120x36" popup on every i3 resize
resize-overlay = never

# Quality-of-life
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true
confirm-close-surface = false
copy-on-select = clipboard

# Faster wheel scrolling (default discrete:3 felt slow vs Firefox/xfce4-terminal)
mouse-scroll-multiplier = precision:3,discrete:5

# Silence everything: no toasts, no bell side-effects, no command-finish pings,
# no terminal-content-triggered desktop notifications (Claude Code OSC 9, etc.)
app-notifications = no-clipboard-copy,no-config-reload
bell-features = no-system,no-audio,no-attention,no-title,no-border
notify-on-command-finish = never
progress-style = false
desktop-notifications = false

# Don't dim the unfocused split
unfocused-split-opacity = 1
focus-follows-mouse = true
