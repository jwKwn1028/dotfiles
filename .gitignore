# Agent scaffolding stays local -- except AGENTS.md and CLAUDE.md, tracked on
# purpose so a fresh clone gets the repo's working rules. Keep both secret-free.
.AGENTS.md
dot_config/private_restic/password
.claude
.codex
claude.md
dot_config/**/dot_git/
dot_config/**/dot_codex/
dot_config/**/dot_agents/
dot_config/i3/resurrect*
dot_config/i3/MANUAL.pdf

# Local operator documentation; also excluded from the target state in
# .chezmoiignore.
/CHEZMOI_UPDATE_WORKFLOW.md

# Local NixOS bootstrap module; copied manually to /etc/nixos when testing.
/desktop.nix

# Browser profiles hold bookmarks, sync identifiers, and machine state. Keep
# the entire source trees local.
dot_config/private_net.imput.helium/
dot_var/app/app.zen_browser.zen/

# Allowlist for ~/.ssh, so a wholesale `chezmoi add ~/.ssh` cannot stage
# id_ed25519 or known_hosts.
private_dot_ssh/*
!private_dot_ssh/private_config.tmpl

__pycache__/
*.py[cod]

prospect.md
