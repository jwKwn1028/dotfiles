_hpc_age() {
  emulate -L zsh
  zmodload -i zsh/datetime
  local t=$1 d

  if [[ $t != <-> ]] || (( t <= 0 )); then
    print -r -- -
    return
  fi

  (( d = EPOCHSECONDS - t ))
  if (( d < 3600 )); then
    print -r -- "$((d / 60))m"
  elif (( d < 86400 )); then
    print -r -- "$((d / 3600))h"
  else
    print -r -- "$((d / 86400))d"
  fi
}

_hpc_sessions() {
  emulate -L zsh
  local host=$1 line sname scount screated spath listing rc probe
  local -a f
  local -A spaths

  probe='tmux list-panes -a -F "P%|%#{session_name}%|%#{pane_active}#{window_active}%|%#{pane_current_path}" 2>/dev/null; tmux list-sessions -F "T%|%#{session_name}%|%#{session_windows}%|%#{session_attached}%|%#{session_created}%|%#{session_activity}%|%#{session_path}" 2>/dev/null; ~/.local/bin/zmx list 2>/dev/null'

  listing=$(command ssh -S none -o ConnectTimeout=8 -o ConnectionAttempts=1 "$host" "$probe")
  rc=$?
  (( rc == 255 )) && return $rc

  for line in ${(f)listing}; do
    if [[ $line == 'P%|%'* ]]; then
      f=("${(@s:%|%:)line}")
      [[ $f[3] == 11 && -n $f[2] ]] && spaths[$f[2]]=$f[4]
    elif [[ $line == 'T%|%'* ]]; then
      f=("${(@s:%|%:)line}")
      print -r -- "tmux%|%$f[2]%|%$f[3]%|%$f[4]%|%$f[5]%|%$f[6]%|%${spaths[$f[2]]:-$f[7]}"
    elif [[ $line == *name=* ]]; then
      sname=${${line#*name=}%%[[:space:]]*}
      scount=${${line#*clients=}%%[[:space:]]*}
      screated=${${line#*created=}%%[[:space:]]*}
      spath=
      [[ $line == *start_dir=* ]] && spath=${line#*start_dir=}
      [[ -n $sname ]] && print -r -- "zmx%|%$sname%|%-%|%$scount%|%$screated%|%-%|%$spath"
    fi
  done
}

_hpc_session_exists() {
  emulate -L zsh
  local host=$1 wanted_kind=$2 wanted_name=$3 line listing
  local -a f

  listing=$(_hpc_sessions "$host") || return

  for line in ${(f)listing}; do
    f=("${(@s:%|%:)line}")
    [[ $f[1] == "$wanted_kind" && $f[2] == "$wanted_name" ]] && return 0
  done

  return 1
}

hpc-list() {
  emulate -L zsh
  local base={{ .sshHpcHost | quote }}
  local home={{ printf "/home/%s" .sshRemoteUser | quote }}
  local out line kind name win clients dir age idle fmt rc
  local -a f

  if (( $# )); then
    print -u2 'usage: hpc-list'
    return 2
  fi

  print -u2 -- 'hpc: connecting to remote host to list sessions...'
  out=$(_hpc_sessions "$base")
  rc=$?
  if (( rc != 0 )); then
    if (( rc == 255 )); then
      print -u2 -- 'hpc: SSH connection to the remote host failed'
    else
      print -u2 -- "hpc: remote session query failed (status $rc)"
    fi
    return $rc
  fi

  if [[ -z $out ]]; then
    print 'no sessions'
    return
  fi

  fmt='%-5s %-18s %4s %8s %6s %6s  %s\n'
  printf $fmt KIND NAME WIN CLIENTS AGE IDLE PATH

  for line in ${(f)out}; do
    f=("${(@s:%|%:)line}")
    kind=$f[1] name=$f[2] win=$f[3] clients=$f[4] dir=$f[7]
    age=$(_hpc_age $f[5])
    idle=$(_hpc_age $f[6])

    [[ -n $dir ]] && dir=${dir/#$home/\~}
    printf $fmt "$kind" "$name" "${win:--}" "${clients:--}" "$age" "$idle" "${dir:--}"
  done
}

hpc() {
  emulate -L zsh
  local base={{ .sshHpcHost | quote }}
  local rc remote_cmd

  if (( $# == 0 )); then
    hpc-list
    return
  fi

  if (( $# > 1 )) || [[ -z $1 || $1 != ${1//[^A-Za-z0-9_-]/} ]]; then
    print -u2 'usage: hpc [session-name]'
    return 2
  fi

  remote_cmd="command -v tmux >/dev/null 2>&1 || { printf '%s\n' 'hpc: tmux is not installed on the remote host' >&2; exit 127; }; "
  remote_cmd+="tmux has-session -t =$1 2>/dev/null || { printf '%s\n' 'hpc: no tmux session named $1' >&2; exit 1; }; "
  remote_cmd+="printf '%s\n' \"hpc: connected; attaching to tmux session '$1'...\" >&2; "
  remote_cmd+="exec tmux attach-session -t =$1"

  print -u2 -- "hpc: connecting to remote host for tmux session '$1'..."
  ssh -S none -o ConnectTimeout=8 -o ConnectionAttempts=1 -t "$base" "$remote_cmd"
  rc=$?
  if (( rc == 255 )); then
    print -u2 -- 'hpc: SSH connection to the remote host failed'
  elif (( rc != 0 && rc != 1 && rc != 127 )); then
    print -u2 -- "hpc: remote attach failed for tmux session '$1' (status $rc)"
  fi
  return $rc
}

hpc-detach() {
  emulate -L zsh
  local base={{ .sshHpcHost | quote }}
  local rc remote_cmd

  if (( $# != 1 )) || [[ -z $1 || $1 != ${1//[^A-Za-z0-9_-]/} ]]; then
    print -u2 'usage: hpc-detach <session-name>'
    return 2
  fi

  remote_cmd="command -v tmux >/dev/null 2>&1 || { printf '%s\n' 'hpc-detach: tmux is not installed on the remote host' >&2; exit 127; }; "
  remote_cmd+="tmux has-session -t '=$1' 2>/dev/null || { printf '%s\n' 'hpc-detach: no tmux session named $1' >&2; exit 1; }; "
  remote_cmd+="tmux detach-client -s '=$1' && printf '%s\n' \"hpc-detach: detached clients from tmux session '$1'\""

  print -u2 -- "hpc-detach: connecting to remote host for tmux session '$1'..."
  ssh -S none -o ConnectTimeout=8 -o ConnectionAttempts=1 "$base" "$remote_cmd"
  rc=$?
  if (( rc == 255 )); then
    print -u2 -- 'hpc-detach: SSH connection to the remote host failed'
  elif (( rc != 0 && rc != 1 && rc != 127 )); then
    print -u2 -- "hpc-detach: remote detach failed for tmux session '$1' (status $rc)"
  fi
  return $rc
}

hpc-kill() {
  emulate -L zsh
  local base={{ .sshHpcHost | quote }}
  local force= entry attached line listing rc

  if [[ $1 == -f ]]; then
    force=1
    shift
  fi

  if (( $# != 1 )) || [[ -z $1 || $1 != ${1//[^A-Za-z0-9_-]/} ]]; then
    print -u2 'usage: hpc-kill [-f] <session-name>'
    return 2
  fi

  listing=$(command ssh "$base" 'tmux list-sessions -F "#{session_name} #{session_attached}" 2>/dev/null')
  rc=$?
  (( rc == 255 )) && return $rc

  for line in ${(f)listing}; do
    if [[ ${line%% *} == "$1" ]]; then
      entry=$line
      break
    fi
  done

  if [[ -z $entry ]]; then
    print -u2 "hpc-kill: no tmux session named $1"
    return 1
  fi

  if [[ -z $force ]]; then
    attached=${entry##* }
    if [[ $attached != <-> ]]; then
      print -u2 "hpc-kill: cannot read client count for $1; use -f to override"
      return 1
    fi
    if (( attached > 0 )); then
      print -u2 "hpc-kill: $1 has $attached client(s) attached; use -f to kill anyway"
      return 1
    fi
  fi

  ssh "$base" "tmux kill-session -t $1 && tmux list-sessions"
}

hpcz-list() {
  emulate -L zsh

  if (( $# )); then
    print -u2 'usage: hpcz-list'
    return 2
  fi

  hpc-list
}

hpcz() {
  emulate -L zsh
  local base={{ .sshHpcHost | quote }} zmx='~/.local/bin/zmx'
  local rc

  if (( $# == 0 )); then
    hpcz-list
    return
  fi

  if (( $# > 1 )) || [[ -z $1 || $1 != ${1//[^A-Za-z0-9_-]/} ]]; then
    print -u2 'usage: hpcz [session-name]'
    return 2
  fi

  _hpc_session_exists "$base" zmx "$1"
  rc=$?
  if (( rc != 0 )); then
    (( rc == 255 )) && return $rc
    print -u2 "hpcz: no zmx session named $1"
    return 1
  fi

  ssh -t "$base" "$zmx attach $1"
}

hpcz-detach() {
  emulate -L zsh
  local base={{ .sshHpcHost | quote }}
  local rc remote_cmd

  if (( $# != 1 )) || [[ -z $1 || $1 != ${1//[^A-Za-z0-9_-]/} ]]; then
    print -u2 'usage: hpcz-detach <session-name>'
    return 2
  fi

  remote_cmd="test -x ~/.local/bin/zmx || { printf '%s\n' 'hpcz-detach: zmx is not installed on the remote host' >&2; exit 127; }; "
  remote_cmd+="~/.local/bin/zmx list 2>/dev/null | command grep -Eq '(^|[[:space:]])name=$1([[:space:]]|$)' || { printf '%s\n' 'hpcz-detach: no zmx session named $1' >&2; exit 1; }; "
  remote_cmd+="env ZMX_SESSION='$1' ~/.local/bin/zmx detach && printf '%s\n' \"hpcz-detach: detached clients from zmx session '$1'\""

  print -u2 -- "hpcz-detach: connecting to remote host for zmx session '$1'..."
  ssh -S none -o ConnectTimeout=8 -o ConnectionAttempts=1 "$base" "$remote_cmd"
  rc=$?
  if (( rc == 255 )); then
    print -u2 -- 'hpcz-detach: SSH connection to the remote host failed'
  elif (( rc != 0 && rc != 1 && rc != 127 )); then
    print -u2 -- "hpcz-detach: remote detach failed for zmx session '$1' (status $rc)"
  fi
  return $rc
}

hpcz-kill() {
  emulate -L zsh
  local base={{ .sshHpcHost | quote }} zmx='~/.local/bin/zmx'
  local force= clients found= line listing
  local -a f

  if [[ $1 == -f ]]; then
    force=1
    shift
  fi

  if (( $# != 1 )) || [[ -z $1 || $1 != ${1//[^A-Za-z0-9_-]/} ]]; then
    print -u2 'usage: hpcz-kill [-f] <session-name>'
    return 2
  fi

  listing=$(_hpc_sessions "$base") || return

  for line in ${(f)listing}; do
    f=("${(@s:%|%:)line}")
    if [[ $f[1] == zmx && $f[2] == "$1" ]]; then
      clients=$f[4]
      found=1
      break
    fi
  done

  if [[ -z $found ]]; then
    print -u2 "hpcz-kill: no zmx session named $1"
    return 1
  fi

  if [[ -z $force ]]; then
    if [[ $clients != <-> ]]; then
      print -u2 "hpcz-kill: cannot read client count for $1; use -f to override"
      return 1
    fi
    if (( clients > 0 )); then
      print -u2 "hpcz-kill: $1 has $clients client(s) attached; use -f to kill anyway"
      return 1
    fi
  fi

  ssh "$base" "$zmx kill $1${force:+ --force} && $zmx list"
}
