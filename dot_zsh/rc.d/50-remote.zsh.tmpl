{{- $tailscaleExitNode := "" -}}
{{- if hasKey . "tailscaleExitNode" }}{{ $tailscaleExitNode = .tailscaleExitNode }}{{ end -}}
# --- Remote Access Tools ---
# Values come from the local chezmoi config; env vars override per session.
HPC_REMOTE_USER=${HPC_REMOTE_USER:-{{ .sshRemoteUser | quote }}}
HPC_REMOTE_HOST=${HPC_REMOTE_HOST:-{{ .sshGpuHost | quote }}}
TAILSCALE_LAB_EXIT_NODE=${TAILSCALE_LAB_EXIT_NODE:-{{ $tailscaleExitNode | quote }}}
TAILSCALE_REMOTE_SERVICE=${TAILSCALE_REMOTE_SERVICE:-tailscale-remote-proxy.service}
TAILSCALE_REMOTE_SOCKET=${TAILSCALE_REMOTE_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$EUID}/tailscale-remote/tailscaled.sock}
TAILSCALE_REMOTE_MODE_FILE=${TAILSCALE_REMOTE_MODE_FILE:-${XDG_RUNTIME_DIR:-/run/user/$EUID}/tailscale-remote-proxy-required}

ssh-close() {
  emulate -L zsh
  local -a hosts tsessions zsessions
  local host all= found=0 label line kind sname scount
  local -a f

  if [[ $1 == -a ]]; then
    all=1
    shift
  fi

  if (( $# > 1 )) || [[ -n $all && $# -eq 1 ]]; then
    print -u2 'usage: ssh-close [-a | HOST_ALIAS]'
    return 2
  fi

  if (( $# == 1 )); then
    command ssh -O exit "$1"
    return
  fi

  hosts=({{ .sshHpcHost | quote }} {{ .sshGpuHost | quote }})

  for host in $hosts; do
    command ssh -O check "$host" >/dev/null 2>&1 || continue
    found=1

    tsessions=()
    zsessions=()

    for line in ${(f)"$(_hpc_sessions "$host")"}; do
      f=("${(@s:%|%:)line}")
      kind=$f[1] sname=$f[2] scount=$f[4]
      [[ -n $sname ]] || continue
      [[ $scount == <-> ]] || scount=
      if [[ $kind == tmux ]]; then
        tsessions+=("$sname${scount:+($scount)}")
      else
        zsessions+=("$sname${scount:+($scount)}")
      fi
    done

    label=$host
    (( $#tsessions )) && label="$label (tmux: ${(j:, :)tsessions})"
    (( $#zsessions )) && label="$label (zmx: ${(j:, :)zsessions})"

    if [[ -n $all ]]; then
      command ssh -O exit "$host" >/dev/null 2>&1 && print "closed: $label"
    else
      print "open: $label"
    fi
  done

  (( found )) || print 'no shared connections open'
}

_labroute_retire_masters() {
  emulate -L zsh
  local host
  local -a hosts

  hosts=({{ .sshHpcHost | quote }} {{ .sshGpuHost | quote }})

  for host in $hosts; do
    [[ -n $host ]] || continue
    command ssh -O stop "$host" >/dev/null 2>&1 || true
  done
}

_labroute_cli() {
  command tailscale --socket="$TAILSCALE_REMOTE_SOCKET" "$@"
}

_labroute_service_active() {
  command systemctl --user is-active --quiet "$TAILSCALE_REMOTE_SERVICE"
}

_labroute_start_service() {
  command systemctl --user daemon-reload &&
  command systemctl --user start "$TAILSCALE_REMOTE_SERVICE"
}

_labroute_stop_service() {
  command systemctl --user stop "$TAILSCALE_REMOTE_SERVICE"
}

_labroute_wait_for_socket() {
  integer attempt

  for attempt in {1..50}; do
    [[ -S "$TAILSCALE_REMOTE_SOCKET" ]] && return 0
    command sleep 0.1
  done

  print -u2 'labroute: the userspace Tailscale daemon did not become ready'
  return 1
}

_labroute_proxy_snapshot_ready() {
  command jq -e '
    .BackendState == "Running" and
    ((.ExitNodeStatus.ID // "") != "") and
    (.ExitNodeStatus.Online == true)
  ' >/dev/null <<<"$1"
}

_labroute_proxy_snapshot_offline() {
  command jq -e '
    .BackendState == "Running" and
    ((.ExitNodeStatus.ID // "") != "") and
    (.ExitNodeStatus.Online != true)
  ' >/dev/null <<<"$1"
}

_labroute_proxy_enabled() {
  local snapshot

  _labroute_service_active || return 1
  snapshot=$(_labroute_cli status --json 2>/dev/null) || return 1
  _labroute_proxy_snapshot_ready "$snapshot"
}

_labroute_wait_for_proxy() {
  integer attempt

  for attempt in {1..50}; do
    _labroute_proxy_enabled && return 0
    command sleep 0.1
  done

  return 1
}

_labroute_proxy_requested() {
  [[ -f "$TAILSCALE_REMOTE_MODE_FILE" ]]
}

_labroute_main_exit_enabled() {
  local snapshot

  snapshot=$(command tailscale status --json 2>/dev/null) || return 1
  command jq -e '((.ExitNodeStatus.ID // "") != "")' >/dev/null \
    <<<"$snapshot"
}

_labroute_require_commands() {
  local dependency

  for dependency in tailscale tailscaled jq systemctl; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
      print -u2 -- "labroute: $dependency is not installed"
      return 127
    fi
  done
}

_labroute_status() {
  local backend snapshot

  if command -v tailscale >/dev/null 2>&1 &&
      command -v jq >/dev/null 2>&1 &&
      _labroute_main_exit_enabled
  then
    print 'Lab SSH route: CONFLICT (the main Tailscale exit node is ON)'
    return 1
  fi

  if ! _labroute_proxy_requested; then
    print 'Lab SSH route: OFF (direct connection)'
    return 0
  fi

  _labroute_require_commands || return

  if ! _labroute_service_active; then
    print 'Lab SSH route: ON (blocked: proxy service is stopped)'
    return 1
  fi

  snapshot=$(_labroute_cli status --json 2>/dev/null) || {
    print 'Lab SSH route: ERROR (proxy service is running but unavailable)'
    return 1
  }
  backend=$(command jq -r '.BackendState // "Unknown"' <<<"$snapshot") || return

  if _labroute_proxy_snapshot_ready "$snapshot"; then
    print 'Lab SSH route: ON'
  elif _labroute_proxy_snapshot_offline "$snapshot"; then
    print 'Lab SSH route: ON (blocked: exit node is offline)'
    return 1
  elif [[ "$backend" == NeedsLogin || "$backend" == NoState ]]; then
    print 'Lab SSH route: ON (blocked: proxy authentication required)'
    return 1
  else
    print -- "Lab SSH route: ON (blocked: proxy daemon: $backend)"
    return 1
  fi
}

# Usage: labroute {on|off|status|toggle}
labroute() {
  emulate -L zsh

  if (( $# > 1 )); then
    print -u2 'usage: labroute {on|off|status|toggle}'
    return 2
  fi

  local route_action=${1:-status}
  local backend proxy_hostname tailscale_snapshot

  case "$route_action" in
    on|off|status|toggle) ;;
    *)
      print -u2 'usage: labroute {on|off|status|toggle}'
      return 2
      ;;
  esac

  if [[ "$route_action" == toggle ]]; then
    if _labroute_proxy_requested; then
      route_action=off
    else
      route_action=on
    fi
  fi

  case "$route_action" in
    status)
      _labroute_status
      ;;
    off)
      _labroute_retire_masters
      command rm -f -- "$TAILSCALE_REMOTE_MODE_FILE" || return
      if command -v systemctl >/dev/null 2>&1 &&
          _labroute_service_active
      then
        if [[ -S "$TAILSCALE_REMOTE_SOCKET" ]]; then
          if command -v tailscale >/dev/null 2>&1; then
            _labroute_cli set --exit-node= >/dev/null 2>&1 ||
              print -u2 'labroute: warning: could not clear the proxy exit-node preference'
          fi
        fi
        _labroute_stop_service ||
          print -u2 'labroute: warning: could not stop the proxy service'
      elif [[ -S "$TAILSCALE_REMOTE_SOCKET" ]]; then
        print -u2 'labroute: warning: could not stop the proxy service'
      fi
      print 'Lab SSH route: OFF (direct connection)'
      ;;
    on)
      _labroute_retire_masters
      if ! : >| "$TAILSCALE_REMOTE_MODE_FILE"; then
        print -u2 'labroute: could not enable proxy-required mode'
        return 1
      fi
      _labroute_require_commands || return
      if [[ -z "$TAILSCALE_LAB_EXIT_NODE" ]]; then
        print -u2 'labroute: tailscaleExitNode is not configured in chezmoi data'
        return 1
      fi
      if _labroute_main_exit_enabled; then
        print -u2 'labroute: the main Tailscale daemon is using an exit node'
        print -u2 'labroute: disable it first with: sudo tailscale set --exit-node='
        return 1
      fi
      if _labroute_proxy_enabled; then
        print 'Lab SSH route is already ON'
        return 0
      fi

      if ! _labroute_start_service; then
        print -u2 'labroute: proxy unavailable; remote SSH remains blocked'
        return 1
      fi
      if ! _labroute_wait_for_socket; then
        _labroute_stop_service >/dev/null 2>&1
        print -u2 'labroute: proxy unavailable; remote SSH remains blocked'
        return 1
      fi

      tailscale_snapshot=$(_labroute_cli status --json 2>/dev/null) ||
        tailscale_snapshot='{}'
      backend=$(command jq -r '.BackendState // "Unknown"' \
        <<<"$tailscale_snapshot") || return

      if [[ "$backend" != Running ]]; then
        proxy_hostname="$(command hostname -s 2>/dev/null)-remote-proxy"
        [[ "$proxy_hostname" == -remote-proxy ]] && proxy_hostname=remote-proxy
        proxy_hostname=${proxy_hostname[1,63]}
        if ! _labroute_cli up \
          --hostname="$proxy_hostname" \
          --accept-dns=false \
          --accept-routes=false
        then
          _labroute_stop_service >/dev/null 2>&1
          print -u2 'labroute: proxy unavailable; remote SSH remains blocked'
          return 1
        fi
      fi

      if ! _labroute_cli set \
        --accept-dns=false \
        --accept-routes=false \
        --exit-node="$TAILSCALE_LAB_EXIT_NODE"
      then
        _labroute_stop_service >/dev/null 2>&1
        print -u2 'labroute: proxy unavailable; remote SSH remains blocked'
        return 1
      fi
      if ! _labroute_wait_for_proxy; then
        tailscale_snapshot=$(_labroute_cli status --json 2>/dev/null) ||
          tailscale_snapshot='{}'
        if _labroute_proxy_snapshot_offline "$tailscale_snapshot"; then
          print -u2 'labroute: exit node is offline; remote SSH remains blocked'
        else
          _labroute_stop_service >/dev/null 2>&1
          print -u2 'labroute: proxy unavailable; remote SSH remains blocked'
        fi
        return 1
      fi
      print 'Lab SSH route: ON'
      ;;
  esac
}

# 1. Quick SFTP connect -- type 'cdcluster' to browse server files
cdcluster() {
  emulate -L zsh
  sftp "${HPC_REMOTE_USER}@${HPC_REMOTE_HOST}"
}

# 2. Smart download -- grem path/to/file

grem() {
  emulate -L zsh

  if (( $# < 1 )); then
    print -u2 "Usage:"
    print -u2 "  grem <remote_path...>"
    print -u2 "  grem [rsync_opts...] -- <remote_path...>"
    return 1
  fi

  local -a rsync_opts remotes
  # --checksum: compare by content hash, so an edit keeping size+mtime transfers.
  rsync_opts=(-aPzh --checksum --info=progress2 --protect-args)

  # If the first argument starts with '-', treat leading args as rsync options.
  if [[ $1 == -* ]]; then
    while (( $# )) && [[ $1 != -- ]]; do
      rsync_opts+=("$1")
      shift
      case "${rsync_opts[-1]}" in
        --exclude|--include|--filter|--exclude-from|--files-from|-e|--rsh)
          (( $# )) || { print -u2 "grem: missing argument for ${rsync_opts[-1]}"; return 2; }
          rsync_opts+=("$1")
          shift
          ;;
      esac
    done

    # consume optional `--`
    [[ $1 == -- ]] && shift
  fi

  if (( $# < 1 )); then
    print -u2 "Usage: grem <remote_path...>  (or: grem [opts...] -- <remote_path...>)"
    return 1
  fi

  local remote="${HPC_REMOTE_USER}@${HPC_REMOTE_HOST}"
  remotes=("${(@)argv/#/${remote}:}")
  rsync "${rsync_opts[@]}" -- "${remotes[@]}" ./
}

# 3. Upload -- prem local_file.py [remote_dest]
prem() {
  emulate -L zsh

  if (( $# < 1 )); then
    print -u2 "Usage:"
    print -u2 "  prem <local_path...> [remote_dest]"
    print -u2 "  prem [rsync_opts...] -- <local_path...> [remote_dest]"
    return 1
  fi

  local -a rsync_opts
  # See grem: content-hash comparison so same-size, same-mtime edits transfer.
  rsync_opts=(-aPzh --checksum --info=progress2 --protect-args)

  # Keep rsync filter globs quoted, e.g. prem --exclude='*.safetensors' -- src/ dst
  if [[ $1 == -* ]]; then
    while (( $# )) && [[ $1 != -- ]]; do
      rsync_opts+=("$1")
      shift
      case "${rsync_opts[-1]}" in
        --exclude|--include|--filter|--exclude-from|--files-from|-e|--rsh)
          (( $# )) || { print -u2 "prem: missing argument for ${rsync_opts[-1]}"; return 2; }
          rsync_opts+=("$1")
          shift
          ;;
      esac
    done

    # consume optional `--`
    [[ $1 == -- ]] && shift
  fi

  if (( $# < 1 )); then
    print -u2 "Usage: prem <local_path...> [remote_dest]  (or: prem [opts...] -- <local_path...> [remote_dest])"
    return 1
  fi

  local dst=""
  local last="${argv[-1]}"
  local -a srcs
  integer i

  # If last arg looks like a remote destination, treat it as destination
  if (( $# >= 2 )) && [[ "$last" == /* || "$last" == ~* ]]; then
    dst="$last"
    for i in {1..$(( $# - 1 ))}; do
      srcs+=("${argv[$i]}")
    done
  else
    srcs=("$@")
  fi

  local remote="${HPC_REMOTE_USER}@${HPC_REMOTE_HOST}"

  # Empty dst -> "host:" -> the remote home, so we do not rely on the remote
  # shell expanding "~". An explicit dst forces directory semantics.
  rsync "${rsync_opts[@]}" -- \
    "${srcs[@]}" "${remote}:${dst:+${dst%/}/}"
}

