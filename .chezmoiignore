# Patterns here match the TARGET path (relative to $HOME), gitignore-style.
{{- $desktopProfile := "none" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if or (eq .chezmoi.osRelease.id "linuxmint") (eq .chezmoi.osRelease.id "ubuntu") -}}
{{-     $desktopProfile = "linuxmint-i3-x11" -}}
{{-   end -}}
{{- end -}}
{{- if hasKey . "desktopProfile" -}}
{{-   $desktopProfile = .desktopProfile -}}
{{- end -}}
{{- $class := "desktop" -}}
{{- if hasKey . "class" -}}
{{-   $class = .class -}}
{{- end }}

# ─── Repo documentation ───────────────────────────────────────────────────
# Repo docs, not dotfiles: without this block `chezmoi apply` writes them to
# ~/README.md and litters $HOME. The leading slash anchors to $HOME so a nested
# README.md elsewhere in the target tree still applies.
/README.md
/X11_TO_WAYLAND_TRANSITION.md
/MACOS_PORTING_GUIDE.md
/CHEZMOI_UPDATE_WORKFLOW.md
/AGENTS.md
/CLAUDE.md
/LICENSE
/desktop.nix

# ─── Browser profiles ──────────────────────────────────────────────────────
# Browser profiles stay local: bookmarks, sync identifiers, site-engagement
# records. The sanitized Zen user.js allowlist is installed separately by the
# profile-discovery script.
.config/net.imput.helium/
.var/app/app.zen_browser.zen/

# ─── Zsh generated and local-only state ──────────────────────────────────────────────
# Bytecode is regenerated by zsh. hxp owns its own absolute symlinks, and the
# dated backup is machine-local. Keep plugin directories available to
# .chezmoiexternal.toml; ignoring them would also disable those externals.
/.zshrc.zwc
/.zsh/**/*.zwc
/.zsh/*.bak.*
/.zsh/hxp-lib.zsh
/.zsh/hxp-main.zsh

# ─── Local-only state inside managed trees ─────────────────────────────────
# The same set .gitignore keeps out of history, kept out of the target state
# too. chezmoi reads the source *directory*, not git, so a file being untracked
# is no protection: without this block `apply` overwrites live i3 session
# snapshots with whatever was last `re-add`ed, and writes Python bytecode and
# nested VCS/agent scaffolding into ~/.config.
#
# Ignoring never deletes a target, so the existing ~/.config/i3/resurrect* stay
# where they are -- i3-resurrect keeps owning them, chezmoi stops.
/.config/i3/resurrect*
**/__pycache__
**/.git
/.config/**/.codex
**/.agents

# Codex mixes machine state (per-project trust levels, hook trust hashes,
# plugin registration, nux counters) into its own config.toml with no include
# directive to split them, so it stays local like ~/.claude.json.
# ~/.codex/rules and ~/.codex/statusline.toml are static and stay managed.
/.codex/config.toml

# ─── Desktop profiles ─────────────────────────────────────────────────────
# Mint's i3 tree is the X11 desktop. A machine on any other profile (a server,
# or `none`) must not receive the X11 session files or helpers.
{{ if ne $desktopProfile "linuxmint-i3-x11" -}}
/.config/i3/
/.config/xfce4/
/.config/polybar/
/.config/picom/
/.config/rofi/
/.x-unstick.sh
/.toggle-touchpad.sh
/.local/bin/touchpad
/.local/bin/disable-trackpoint-middle-click

# Thunar's Ghostty-TokyoNight theme (~1M of assets), the GTK_THEME wrapper that
# switches it on, and the two launch paths through it. Ship all or none.
/.themes/Ghostty-TokyoNight/
/.local/bin/thunar
/.local/share/applications/thunar.desktop
/.config/systemd/user/thunar.service.d/
{{ end -}}

# ─── Desktop-class payloads ───────────────────────────────────────────────
# Zen's chrome/ source, a 3.3M wallpaper included. Gated on class like the
# script that installs it: a macOS desktop wants these, a server does not.
{{ if ne $class "desktop" -}}
/.local/share/zen-chrome/
{{ end -}}

/prospect.md
