# Patterns here match the TARGET path (relative to $HOME), gitignore-style.
{{- $desktopProfile := "none" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if or (eq .chezmoi.osRelease.id "linuxmint") (eq .chezmoi.osRelease.id "ubuntu") -}}
{{-     $desktopProfile = "linuxmint-i3-x11" -}}
{{-   else if eq .chezmoi.osRelease.id "cachyos" -}}
{{-     $desktopProfile = "cachyos-niri-noctalia" -}}
{{-   end -}}
{{- end -}}
{{- if hasKey . "desktopProfile" -}}
{{-   $desktopProfile = .desktopProfile -}}
{{- end -}}
{{- /* Arch-family detection, used for packaging differences rather than for
       desktop routing. CachyOS reports id "cachyos" / idLike "arch". */ -}}
{{- $archFamily := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $id := .chezmoi.osRelease.id -}}
{{-   $idLike := "" -}}
{{-   if hasKey .chezmoi.osRelease "idLike" -}}
{{-     $idLike = .chezmoi.osRelease.idLike -}}
{{-   end -}}
{{-   if or (eq $id "arch") (eq $id "cachyos") (contains "arch" $idLike) -}}
{{-     $archFamily = true -}}
{{-   end -}}
{{- end }}

# ─── Repo documentation ───────────────────────────────────────────────────
# These describe the source repo; they are not dotfiles. Without this block
# `chezmoi apply` writes them to ~/README.md etc. (`chezmoi status` shows them
# as `A`), littering $HOME. Leading slash anchors to $HOME so that a nested
# README.md elsewhere in the target tree is still applied normally.
/README.md
/X11_TO_WAYLAND_TRANSITION.md
/CACHYOS_TRANSFER_GUIDE.md
/MACOS_PORTING_GUIDE.md
/CHEZMOI_UPDATE_WORKFLOW.md
/AGENTS.md
/CLAUDE.md
/LICENSE

# ─── Browser profiles ──────────────────────────────────────────────────────
# Browser-generated profiles stay local. They contain bookmarks, account/sync
# identifiers, site-engagement records, and other machine-generated state.
# The sanitized Zen user.js allowlist is installed by the profile-discovery
# script without exposing or managing the rest of the profile.
.config/net.imput.helium/
.var/app/app.zen_browser.zen/

# ─── Zsh generated and local-only state ──────────────────────────────────────────────
# Bytecode is regenerated by zsh. hxp owns its own absolute symlinks, and the
# dated backup is machine-local. Keep plugin directories available to
# .chezmoiexternal.toml; ignoring them would also disable those externals.
/.zshrc.zwc
/.zsh/**/*.zwc
/.zsh/*.bak.*
/.zsh/hxp-lib.zsh
/.zsh/hxp-main.zsh

# ─── Desktop profiles ─────────────────────────────────────────────────────
# Mint's i3 tree is a known-good X11 fallback. CachyOS uses the independently
# installed Niri + Noctalia desktop and must not receive any of the X11
# session files or helpers.
{{ if ne $desktopProfile "linuxmint-i3-x11" -}}
/.config/i3/
/.config/polybar/
/.config/picom/
/.config/rofi/
/.x-unstick.sh
/.toggle-touchpad.sh
/.local/bin/touchpad
/.local/bin/disable-trackpoint-middle-click
{{ end -}}

# ─── Distro packaging differences ─────────────────────────────────────────
# Arch/CachyOS ship Helix as `helix` and provide no `hx`; Debian/Ubuntu and
# the upstream tarball ship `hx`. ~/.local/bin/hx is a compat symlink that
# must exist only where the distro omits the name -- elsewhere it would
# shadow the real binary. See dot_local/bin/symlink_hx.tmpl.
{{ if not $archFamily -}}
/.local/bin/hx
{{ end -}}

# Niri and curated Noctalia configuration belong only to the CachyOS profile.
# Noctalia's runtime state and cache remain local on every profile.
{{ if ne $desktopProfile "cachyos-niri-noctalia" -}}
/.config/niri/
/.config/noctalia/
{{ end -}}
/.local/state/noctalia/
/.cache/noctalia/
