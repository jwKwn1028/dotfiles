# Patterns here match the TARGET path (relative to $HOME), gitignore-style.
{{- $desktopProfile := "none" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if or (eq .chezmoi.osRelease.id "linuxmint") (eq .chezmoi.osRelease.id "ubuntu") -}}
{{-     $desktopProfile = "linuxmint-i3-x11" -}}
{{-   end -}}
{{- end -}}
{{- if hasKey . "desktopProfile" -}}
{{-   $desktopProfile = .desktopProfile -}}
{{- end -}}
{{- $class := "desktop" -}}
{{- if hasKey . "class" -}}
{{-   $class = .class -}}
{{- end }}

# ─── Repo documentation ───────────────────────────────────────────────────
# Repo docs, not dotfiles: without this, `chezmoi apply` writes them to ~/ and
# litters $HOME. The leading slash anchors to $HOME so a nested README.md applies.
/README.md
/X11_TO_WAYLAND_TRANSITION.md
/MACOS_PORTING_GUIDE.md
/CHEZMOI_UPDATE_WORKFLOW.md
/AGENTS.md
/CLAUDE.md
/LICENSE
/desktop.nix

# ─── Browser profiles ──────────────────────────────────────────────────────
# Browser profiles stay local: bookmarks, sync identifiers, engagement records.
# The publishable settings are installed by the run_onchange_ profile scripts.
.mozilla/firefox/
snap/firefox/common/.mozilla/firefox/
.var/app/org.mozilla.firefox/.mozilla/firefox/
.config/net.imput.helium/
.var/app/app.zen_browser.zen/

# ─── Zsh generated and local-only state ──────────────────────────────────────────────
# Bytecode is regenerated by zsh, hxp owns its symlinks, and the dated backup is
# machine-local. Keep plugin directories available to .chezmoiexternal.toml.
/.zshrc.zwc
/.zsh/**/*.zwc
/.zsh/*.bak.*
/.zsh/hxp-lib.zsh
/.zsh/hxp-main.zsh

# ─── Local-only state inside managed trees ─────────────────────────────────
# The same set .gitignore keeps out of history, kept out of the target state
# too. chezmoi reads the source *directory*, not git, so untracked is no
# protection: without this, `apply` overwrites live i3 session snapshots and
# writes bytecode and nested VCS/agent scaffolding into ~/.config. Ignoring
# never deletes a target, so existing ~/.config/i3/resurrect* stay put.
/.config/i3/resurrect*
/.config/ghostty/tabbar-state.conf
**/__pycache__
**/.git
/.config/**/.codex
**/.agents

# The repository password is created locally by `restic-backup init`; it must
# never become chezmoi source state.
/.config/restic/password

# This restic setup uses Linux mount inspection and systemd user timers.
{{ if ne .chezmoi.os "linux" -}}
/.config/restic/
/.config/systemd/user/restic-backup.service
/.config/systemd/user/restic-backup.timer
/.config/systemd/user/restic-maintenance.service
/.config/systemd/user/restic-maintenance.timer
/.local/bin/restic-backup
{{ end -}}

# Codex mixes machine state (trust levels, hook hashes, plugin registration,
# nux counters) into its own config.toml with no include directive. A modify_
# script manages only the model and reasoning effort; the rest stays local.
# ~/.codex/rules and statusline.toml are static and stay managed. ~/.claude.json
# is the same story and has no source-state entry at all. See AGENTS.md,
# "Agent tooling this repo does not manage".

# ─── Desktop profiles ─────────────────────────────────────────────────────
# Mint's i3 tree is the X11 desktop; any other profile must not receive it.
{{ if ne $desktopProfile "linuxmint-i3-x11" -}}
/.config/i3/
/.config/xfce4/
/.config/polybar/
/.config/picom/
/.config/rofi/
/.config/fcitx5/
/.x-unstick.sh
/.toggle-touchpad.sh
/.local/bin/touchpad
/.local/bin/disable-trackpoint-middle-click

# Thunar's Ghostty-TokyoNight theme (~1M), the GTK_THEME wrapper that switches
# it on, and both launch paths through it. Ship all or none.
/.themes/Ghostty-TokyoNight/
/.local/bin/thunar
/.local/share/applications/thunar.desktop
/.config/systemd/user/thunar.service.d/
{{ end -}}

# ─── Desktop-class payloads ───────────────────────────────────────────────
# Zen's chrome/ source and Helium's new-tab background, gated on class like the
# scripts that install them.
{{ if ne $class "desktop" -}}
/.local/share/zen-chrome/
/.local/share/helium-newtab/
{{ end -}}

# Zen's flatpak override: `persistent=.mozilla` keeps the native messaging
# manifest visible, and the bus grant lets the browserpass shim call
# flatpak-spawn. Linux desktops only.
{{ if or (ne $class "desktop") (ne .chezmoi.os "linux") -}}
/.local/share/flatpak/overrides/app.zen_browser.zen
{{ end -}}

/prospect.md
