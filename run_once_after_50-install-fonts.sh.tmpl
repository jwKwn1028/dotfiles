#!/usr/bin/env bash
{{ $class := "desktop" -}}
{{ if hasKey . "class" }}{{ $class = .class }}{{ end -}}
# Installs the fonts the desktop configs name by family:
#   - NewComputerModernMono10 : ghostty primary face; rofi launcher font
#   - NewComputerModernSans10 : polybar's font-0
#   - NanumGothicCoding       : Korean monospace fallback in ghostty
#   - JetBrainsMono Nerd Font : icon glyphs used by polybar and starship
#
# Installed to ~/.local/share/fonts from upstream archives. New Computer
# Modern takes an apt fast path because Debian packages it.
set -euo pipefail

{{ if ne $class "desktop" -}}
echo "Non-desktop class; skipping fonts."
exit 0
{{- else -}}
fontdir="$HOME/.local/share/fonts"
mkdir -p "$fontdir"

# Test the family name recorded inside the file, never the filename: the
# codeface build of NanumGothicCoding registers as "NanumGothic_Coding" and
# silently fails to match the configs.
#
# `grep -ix ... >/dev/null`, not `grep -qix`: -q exits at the first match,
# SIGPIPEs fc-list upstream, and under `set -o pipefail` turns the pipeline
# non-zero -- reporting "missing" exactly when the font IS installed.
have_family() {
    fc-list : family 2>/dev/null | tr ',' '\n' | grep -ix -- "$1" >/dev/null
}

# install_zip URL DESTDIR FAMILY=GLOB [FAMILY=GLOB ...]
# Fetches a zip once and copies each GLOB into DESTDIR, skipping the download
# when every named family already resolves. Multiple families per call because
# one archive can carry several faces. Best-effort: a failure warns rather than
# aborting provisioning.
install_zip() {
    local url="$1" dest="$2"
    shift 2
    local spec names="" missing=0 tmp

    for spec in "$@"; do
        names="${names:+$names, }${spec%%=*}"
        have_family "${spec%%=*}" || missing=1
    done

    if [ "$missing" -eq 0 ]; then
        echo "  $names already present"
        return 0
    fi

    echo "==> installing $names"
    tmp="$(mktemp -d)"
    if ! curl -fsSL -o "$tmp/font.zip" "$url"; then
        echo "WARN: could not download $names from $url"
        rm -rf "$tmp"
        return 1
    fi
    if ! unzip -qo "$tmp/font.zip" -d "$tmp/extracted"; then
        echo "WARN: could not unpack the $names archive"
        rm -rf "$tmp"
        return 1
    fi
    mkdir -p "$dest"
    # Naver's archive carries macOS resource forks (._*). They match *.ttf but
    # are not fonts, and fontconfig reports each one as a broken font file.
    for spec in "$@"; do
        find "$tmp/extracted" -type f -name "${spec#*=}" ! -name '._*' \
            -exec cp {} "$dest/" \;
    done
    rm -rf "$tmp"
}

# --- New Computer Modern (Mono + Sans) ---
# Two faces from one archive: Mono is ghostty's primary face and the rofi
# launcher font, Sans is the polybar bar font. Debian's
# fonts-newcomputermodern package carries both.
if { ! have_family "NewComputerModernMono10" || ! have_family "NewComputerModernSans10"; } &&
    command -v apt-get >/dev/null 2>&1; then
    sudo apt-get install -y fonts-newcomputermodern 2>/dev/null || true
    fc-cache -f >/dev/null 2>&1 || true
fi
# Upstream CTAN archive, used wherever apt did not supply it.
install_zip \
    "https://mirrors.ctan.org/fonts/newcomputermodern.zip" \
    "$fontdir/NewComputerModern" \
    'NewComputerModernMono10=NewCMMono10-*.otf' \
    'NewComputerModernSans10=NewCMSans10-*.otf' || true

# --- NanumGothicCoding ---
# Naver's own GitHub release. Do not substitute the AUR package or the older
# mirrors: ttf-nanumgothic_coding still points at dev.naver.com, which Naver
# retired, so it cannot build.
install_zip \
    "https://github.com/naver/nanumfont/releases/download/VER2.5/NanumGothicCoding-2.5.zip" \
    "$fontdir/NanumGothicCoding" \
    'NanumGothicCoding=*.ttf' || true

# --- JetBrainsMono Nerd Font ---
install_zip \
    "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip" \
    "$fontdir/JetBrainsMonoNerd" \
    'JetBrainsMono Nerd Font=*.ttf' || true

fc-cache -f "$fontdir" >/dev/null
echo "==> fonts done."

# Surface anything the desktop configs still cannot resolve, rather than
# leaving it to be discovered as tofu in the terminal later.
for family in "NewComputerModernMono10" "NewComputerModernSans10" \
    "NanumGothicCoding" "JetBrainsMono Nerd Font"; do
    have_family "$family" || echo "WARN: $family is still unresolved."
done
{{- end }}
