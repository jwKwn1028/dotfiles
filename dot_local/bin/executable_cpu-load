#!/usr/bin/env bash
# Shared CPU-load calculator for polybar's cpu module and zsh `sysmon`, so both
# report the same number.
#
# Definition (matches top/htop/mpstat): load% = 100 * busy / total, where
#   busy = total - (idle + iowait)      # iowait counts as idle, NOT as load
#
# Stateful and non-blocking: each call diffs /proc/stat against the previous
# snapshot, so the % averages over the time since it.
#
# Usage: cpu-load [instance] [interval_seconds]
#   instance  state key, so independent callers keep separate snapshots
#   interval  the caller's poll rate; decides when a snapshot is too fresh
#
# One key is shared by several processes (polybar runs a bar per monitor). They
# must not consume each other's snapshot, which would shrink the window to
# milliseconds and read whatever burst it lands on, so the first caller in a
# cycle advances the window and the rest reuse its result.

export LC_ALL=C                        # keep EPOCHREALTIME's decimal point a "."

instance="${1:-default}"
interval="${2:-2}"
state="${XDG_RUNTIME_DIR:-/tmp}/cpu-load.${instance}.state"

# Aggregate cpu line: user nice system idle iowait irq softirq steal guest*.
# Emit two running totals: "<total_jiffies> <idle_jiffies>".
snapshot() {
  local _ user nice system idle iowait irq softirq steal
  read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
  printf '%d %d' \
    "$(( user + nice + system + idle + iowait + irq + softirq + steal ))" \
    "$(( idle + iowait ))"
}

now_us=${EPOCHREALTIME/./}
read -r cur_total cur_idle <<< "$(snapshot)"

prev_total='' prev_idle='' prev_us='' prev_load=''
[[ -r $state ]] && read -r prev_total prev_idle prev_us prev_load < "$state"

# Too soon: another process already measured this cycle. 75% of the interval, so
# two callers polling at the same rate can never both advance.
if [[ -n $prev_us && -n $prev_load ]] &&
   (( now_us - prev_us < interval * 750000 )); then
  echo "$prev_load"
  exit 0
fi

if [[ -z $prev_total ]]; then
  # No prior snapshot: take one short sample so the first call is meaningful.
  prev_total=$cur_total prev_idle=$cur_idle
  sleep 0.3
  read -r cur_total cur_idle <<< "$(snapshot)"
  now_us=${EPOCHREALTIME/./}
fi

dt=$(( cur_total - prev_total ))
di=$(( cur_idle - prev_idle ))
if (( dt <= 0 )); then
  load=0
else
  load=$(( (100 * (dt - di) + dt / 2) / dt ))   # round to nearest percent
  (( load < 0 ))   && load=0
  (( load > 100 )) && load=100
fi

# Rename, not write-in-place: a concurrent reader must never see a half line.
printf '%s %s %s %s\n' "$cur_total" "$cur_idle" "$now_us" "$load" > "$state.$$"
mv -f "$state.$$" "$state"

echo "$load"
