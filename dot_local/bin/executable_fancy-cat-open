#!/bin/sh
# fancy-cat FILE [PAGE] here if the terminal can draw it, else in Ghostty.
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo 'usage: fancy-cat-open FILE [PAGE]' >&2
    exit 2
fi
command -v fancy-cat >/dev/null 2>&1 || {
    echo 'fancy-cat-open: fancy-cat not found' >&2
    exit 127
}
file=$1
shift
if [ ! -f "$file" ]; then
    printf "fancy-cat-open: '%s' not found\n" "$file" >&2
    exit 1
fi
# Absolute: valid in a new window and safe for leading '-'.
case "$file" in
    /*) ;;
    *) file="$PWD/$file" ;;
esac

# Needs Kitty graphics: tmux passthrough (fork check), Ghostty, or kitty.
if [ -n "${TMUX:-}" ]; then
    # Restored panes can start before a client attaches.
    tries=0 visible_tries=0
    until fancy-cat --tmux-supported >/dev/null 2>&1 || [ -n "${SSH_CONNECTION:-}" ]; do
        client=$(tmux display -p -t "${TMUX_PANE:-}" '#{client_termname}' 2>/dev/null) || break
        tries=$((tries + 1))
        [ -z "$client" ] || visible_tries=$((visible_tries + 1))
        [ "$tries" -lt 40 ] && [ "$visible_tries" -lt 4 ] || break
        sleep 0.25
    done
    fancy-cat --tmux-supported >/dev/null 2>&1 && exec fancy-cat "$file" "$@"
elif [ "${TERM_PROGRAM:-}" = ghostty ] || [ -n "${KITTY_WINDOW_ID:-}" ]; then
    exec fancy-cat "$file" "$@"
fi

if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    echo 'fancy-cat-open: this terminal cannot show the PDF and there is no display for Ghostty' >&2
    exit 1
fi
command -v ghostty >/dev/null 2>&1 || {
    echo 'fancy-cat-open: ghostty is required to show the PDF here' >&2
    exit 127
}
# A separate instance blocks until the window closes.
exec ghostty --gtk-single-instance=false --quit-after-last-window-closed=true \
    --quit-after-last-window-closed-delay=0s --working-directory="$PWD" \
    --window-padding-x=1 --window-padding-y=1 \
    -e fancy-cat "$file" "$@"
