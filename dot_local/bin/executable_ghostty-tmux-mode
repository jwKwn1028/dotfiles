#!/usr/bin/python3
"""Send the Ghostty key-table binding to the focused X11 window."""
import argparse
import contextlib
import io
import os
from pathlib import Path
import select
import time

from Xlib import X, XK, display
from Xlib.error import XError
from Xlib.ext import xtest

KEYS = {"on": "m", "off": "n"}
LOCKS = {XK.XK_Caps_Lock, XK.XK_Num_Lock, XK.XK_Shift_Lock}
GHOSTTY_CLASS = "com.mitchellh.ghostty"


def client_window(pid):
    try:
        entries = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        env = dict(entry.split(b"=", 1) for entry in entries if b"=" in entry)
        return int(env.get(b"WINDOWID", b"0")), env.get(b"I3_RESURRECT_TMUX_CLIENT") == b"1"
    except (OSError, ValueError):
        pass
    return 0, False


def wait_for_focus(d, root, active, window, pid, timeout=60):
    try:
        fd = os.pidfd_open(pid)
    except OSError:
        return False
    deadline = time.monotonic() + timeout  # Later focus goes through tmux's client-focus-in hook.
    try:
        root.change_attributes(event_mask=X.PropertyChangeMask)
        while active() != window:
            if not d.pending_events():
                ready, _, _ = select.select([d.fileno(), fd], [], [], max(0, deadline - time.monotonic()))
                if not ready or fd in ready:
                    return False
            d.next_event()
        return True
    finally:
        os.close(fd)


def keyboard_grabbed(d, root):
    """Whether another client (e.g. i3lock) holds the keyboard; an unmapped probe never grabs."""
    probe = root.create_window(0, 0, 1, 1, 0, 0, window_class=X.InputOnly)
    try:
        status = probe.grab_keyboard(False, X.GrabModeAsync, X.GrabModeAsync, X.CurrentTime)
        if status == X.GrabSuccess:
            d.ungrab_keyboard(X.CurrentTime)
        return status == X.AlreadyGrabbed
    finally:
        probe.destroy()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=KEYS)
    parser.add_argument("--tmux-client", type=int)
    parser.add_argument("--on-attach", action="store_true")
    args = parser.parse_args()
    if args.tmux_client is not None:
        window, restored = client_window(args.tmux_client)
        if not 0 < window < 2**32:
            return 0
    try:
        with contextlib.redirect_stderr(io.StringIO()):  # python-xlib's .Xauthority warnings
            d = display.Display()
    except Exception:
        return 0
    if not d.has_extension("XTEST"):
        return 1
    root = d.screen().root
    net_active = d.intern_atom("_NET_ACTIVE_WINDOW")

    def active():
        prop = root.get_full_property(net_active, X.AnyPropertyType)
        return prop.value[0] if prop is not None and len(prop.value) else 0

    start = active()
    if args.tmux_client is not None:
        try:
            classes = d.create_resource_object("window", window).get_wm_class() or ()
        except XError:
            return 0
        if not any(name == GHOSTTY_CLASS or name.startswith(GHOSTTY_CLASS + ".") for name in classes):
            return 0
        if start != window and not (args.on_attach and restored and wait_for_focus(d, root, active, window, args.tmux_client)):
            return 0
        start = window
    mods = {kc for codes in d.get_modifier_mapping() for kc in codes
            if kc and d.keycode_to_keysym(kc, 0) not in LOCKS}
    deadline = time.monotonic() + 1.0
    while any(d.query_keymap()[kc // 8] >> (kc % 8) & 1 for kc in mods):
        if time.monotonic() > deadline:
            return 1
        time.sleep(0.01)
    if active() != start or keyboard_grabbed(d, root):
        return 1
    codes = [d.keysym_to_keycode(XK.string_to_keysym(name))
             for name in ("Control_L", "Alt_L", "Shift_L", KEYS[args.mode])]
    if 0 in codes:
        return 1
    for kc in codes:
        xtest.fake_input(d, X.KeyPress, kc)
    for kc in reversed(codes):
        xtest.fake_input(d, X.KeyRelease, kc)
    d.sync()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
