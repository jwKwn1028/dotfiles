#!/usr/bin/env bash
# Session menu for the CachyOS Niri desktop. It replaces two things at once:
# noctalia-shell's sessionMenu, and the expanding power menu that
# dot_config/polybar/config.ini gives the Mint bar.
#
# Usage:
#   session-menu            open the menu   (Mod+Shift+Q, and the waybar
#                                            power glyph)
#   session-menu ACTION     run one action  (Mod+Alt+L -> lock)
#
#   ACTION: lock | suspend | logout | reboot | poweroff
#
# The menu is fuzzel in dmenu mode, so it picks up ~/.config/fuzzel/fuzzel.ini
# and looks like the rofi menus this desktop is modelled on. The Nerd Font has
# to be named explicitly because JuliaMono carries no icon glyphs. It stays at
# 16 while the text drops to 13, the same text/icon split polybar uses.
set -u

FONT='JuliaMono:size=13,NanumGothicCoding:size=13,JetBrainsMono Nerd Font:size=16'

# Narrower than the 54-character application launcher: this is a dialog, not
# a list of everything installed.
WIDTH=30

# Polybar's confirm-poweroff.sh gave the shutdown dialog a deadline and
# powered off when it expired -- "if you do nothing, shutdown will start in N
# seconds". That behaviour is deliberate and is kept here: dismissing the
# dialog by walking away still shuts the machine down.
POWEROFF_TIMEOUT="${SESSION_MENU_TIMEOUT:-30}"

lock() {
    # Locking twice stacks two lock surfaces and only the top one accepts a
    # password, so an already-locked session is left alone.
    pgrep -x swaylock >/dev/null 2>&1 && return 0
    if command -v swaylock >/dev/null 2>&1; then
        swaylock -f
    else
        # No locker installed: let logind tell whatever is listening.
        loginctl lock-session
    fi
}

# confirm PROMPT [TIMEOUT]
# Yes/Cancel in the launcher's own styling. Returns 0 to go ahead. With a
# TIMEOUT, running out of time counts as Yes -- timeout(1) reports 124, or
# 137 when it had to escalate to SIGKILL.
confirm() {
    local prompt="$1" limit="${2:-0}" choice status
    if [ "$limit" -gt 0 ]; then
        choice="$(printf 'Yes\nCancel\n' |
            timeout "$limit" fuzzel --dmenu --font "$FONT" \
                --width "$WIDTH" --lines 2 --prompt "$prompt " --placeholder '')"
        status=$?
    else
        choice="$(printf 'Yes\nCancel\n' |
            fuzzel --dmenu --font "$FONT" \
                --width "$WIDTH" --lines 2 --prompt "$prompt " --placeholder '')"
        status=$?
    fi

    case "$status:$choice" in
        0:Yes) return 0 ;;
        124:*|137:*)
            [ "$limit" -gt 0 ] && return 0
            ;;
    esac
    return 1
}

run_action() {
    case "$1" in
        lock)     lock ;;
        suspend)  lock; systemctl suspend ;;
        reboot)   systemctl reboot ;;
        logout)
            # Polybar guarded "exit i3" with a confirmation submenu and no
            # deadline; niri's own prompt is skipped so there is just the one.
            confirm 'Log out of niri?' && niri msg action quit --skip-confirmation
            ;;
        poweroff)
            confirm "Shut down in ${POWEROFF_TIMEOUT}s?" "$POWEROFF_TIMEOUT" &&
                systemctl poweroff
            ;;
        *)
            printf 'session-menu: unknown action: %s\n' "$1" >&2
            return 2
            ;;
    esac
}

menu() {
    local sel
    # Glyphs and their order follow polybar's menu-0-* entries, with suspend
    # added for the laptop.
    sel="$(printf '%s\n' \
        "  Lock" \
        "  Suspend" \
        "  Log out" \
        "  Reboot" \
        "  Shut down" |
        fuzzel --dmenu --font "$FONT" \
            --width "$WIDTH" --lines 5 --prompt '' --placeholder 'Session')" || return 0

    case "$sel" in
        *Lock)        run_action lock ;;
        *Suspend)     run_action suspend ;;
        *'Log out')   run_action logout ;;
        *Reboot)      run_action reboot ;;
        *'Shut down') run_action poweroff ;;
        *)            return 0 ;;
    esac
}

if [ "$#" -eq 0 ]; then
    menu
else
    run_action "$1"
fi
