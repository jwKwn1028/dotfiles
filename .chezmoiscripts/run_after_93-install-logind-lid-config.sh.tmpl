{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# Drop-in rather than an edit to /etc/systemd/logind.conf: that file is a dpkg
# conffile, so editing it prompts on every `apt upgrade` of systemd.

if [ ! -e /proc/acpi/button/lid ]; then
    echo "No lid switch; skipping logind lid configuration."
    exit 0
fi

dropin=/etc/systemd/logind.conf.d/10-lid-switch.conf

{{ template "script-helpers/install-root-config.sh" . }}

# logind picks the first rule that matches: docked, then on mains, then plain.
install_config "$dropin" -D <<'EOF'
[Login]
# Docked or a second display attached: the lid is just one more screen.
HandleLidSwitchDocked=ignore
# On mains, lock instead of suspending so long jobs survive a closed lid.
# xss-lock answers logind's Lock signal.
HandleLidSwitchExternalPower=lock
# On battery, suspend: an ignored lid drains the pack flat in a bag.
HandleLidSwitch=suspend
EOF

if [ "$changed" -eq 1 ]; then
    echo "==> Reloading systemd-logind"
    sudo systemctl reload systemd-logind
fi

# A handle-lid-switch inhibitor always wins over this drop-in, and
# xfce4-power-manager takes one the moment it stops deferring to logind. That
# swap is silent, so surface it here.
#
# The deferral itself is seeded by xfce4-power-manager.xml, which sets
# logind-handle-lid-switch=true and leaves lid-action-on-* unset: those only
# apply if the deferral flips false. That note cannot live in the XML -- xfconf
# rewrites the file and strips comments, which reads as permanent chezmoi drift.
if command -v xfconf-query >/dev/null 2>&1 &&
    defer=$(xfconf-query -c xfce4-power-manager \
        -p /xfce4-power-manager/logind-handle-lid-switch 2>/dev/null) &&
    [ "$defer" != "true" ]; then
    echo "WARNING: xfce4-power-manager logind-handle-lid-switch=$defer;" >&2
    echo "         xfpm now owns the lid and $dropin is inert." >&2
fi
{{- end }}
