# Lazy conda, mirroring ~/.zsh/conda-lazy.zsh. The `conda init` block this
# replaces ran `conda shell.bash hook` (a python start-up) on every interactive
# shell; these stubs pay that cost only when one of the tools is first used.
lazy_conda_commands=(conda python pip jupyter mamba)

_conda_init_lazy() {
  local cmd conda_root="$HOME/miniconda3"

  for cmd in "${lazy_conda_commands[@]}"; do
    unalias "$cmd" 2>/dev/null
    unset -f "$cmd" 2>/dev/null
  done
  unset -f _conda_init_lazy

  [ -x "$conda_root/bin/conda" ] || {
    echo "conda not found at $conda_root/bin/conda" >&2
    return 127
  }
  eval "$("$conda_root/bin/conda" shell.bash hook 2>/dev/null)" || return 127

  # auto_activate is off (~/.condarc); make sure the wrapped tools actually
  # come from conda. Unless the command already resolves inside $conda_root,
  # activate base first -- this covers both "not found" (python) and "shadowed
  # by a system binary" (Ubuntu's /usr/bin/pip). `conda` itself is exempt: the
  # hook defines it as a function.
  if [ "$1" != conda ] && [[ "$(type -P -- "$1" 2>/dev/null)" != "$conda_root"/* ]]; then
    conda activate base 2>/dev/null
  fi

  "$@"
}

for _lazy_cmd in "${lazy_conda_commands[@]}"; do
  eval "${_lazy_cmd}() { _conda_init_lazy ${_lazy_cmd} \"\$@\"; }"
done
