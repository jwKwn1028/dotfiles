# Auto-list on cd (bash chpwd equivalent; mirrors _auto_ls in
# ~/.zsh/rc.d/35-navigation.zsh).
#
# Names only: the `ls` alias above adds --long --git, which costs a git status
# per file. This runs on every directory change, so it stays a plain grid --
# one fork, no git.
#
# Skipped past AUTO_LS_MAX entries so `cd /usr/bin` does not scroll the screen
# away. Counted with a glob rather than `eza | wc -l` so the common case forks
# once, not twice; dotfiles are excluded, matching eza's default.
if _have eza; then
  AUTO_LS_MAX=${AUTO_LS_MAX:-50}
  __chpwd_last=$PWD
  __chpwd_auto_ls() {
    [[ $PWD == "$__chpwd_last" ]] && return
    __chpwd_last=$PWD
    local -a entries=(*)
    (( ${#entries[@]} <= AUTO_LS_MAX )) && eza --color=auto --icons
  }
  case ";${PROMPT_COMMAND:-};" in
    *";__chpwd_auto_ls;"*) ;;
    *) PROMPT_COMMAND="__chpwd_auto_ls${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
  esac
fi

