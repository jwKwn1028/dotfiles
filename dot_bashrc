# --------------------------------------------------------
# Shared helpers (mirrors ~/.zsh/rc.d/_lib.zsh)
# --------------------------------------------------------
# _have <cmd> -> succeeds if <cmd> is an external command on PATH.
_have() { type -P -- "$1" >/dev/null 2>&1; }

# Resolve tool variants once so every block below agrees on the same binary.
#   $_bash_fd  -> fd | fdfind | ''   (Debian/Ubuntu package fd as fdfind)
#   $_bash_bat -> bat | batcat | cat
if   _have fd;     then _bash_fd=fd
elif _have fdfind; then _bash_fd=fdfind
else                    _bash_fd=
fi
if   _have bat;    then _bash_bat=bat
elif _have batcat; then _bash_bat=batcat
else                    _bash_bat='cat'
fi

# _bash_ls_files [-d] [ext]
#   Print candidate paths under $PWD: hidden included, .git pruned,
#   .gitignore NOT honored (fd would otherwise hide files the find(1)
#   fallback lists, making the same call differ per machine).
#   -d lists directories instead; ext restricts to files with that
#   extension (case-insensitive).
_bash_ls_files() {
  local kind=file ext
  local -a cmd
  [ "$1" = -d ] && { kind=dir; shift; }
  ext="$1"

  if [ -n "$_bash_fd" ]; then
    cmd=("$_bash_fd" --hidden --no-ignore --exclude .git --strip-cwd-prefix)
    if [ "$kind" = dir ]; then
      cmd+=(--type d)
    elif [ -n "$ext" ]; then
      cmd+=(-e "$ext")
    fi
    "${cmd[@]}"
  else
    cmd=(find . -mindepth 1)
    if [ "$kind" = dir ]; then
      cmd+=(-type d)
    else
      cmd+=(-type f)
      [ -n "$ext" ] && cmd+=(-iname "*.$ext")
    fi
    cmd+=(-not -path '*/.git' -not -path '*/.git/*' -print)
    "${cmd[@]}" | sed 's|^\./||'
  fi
}

