# --------------------------------------------------------
# PDF / EPUB openers (fzf)
# --------------------------------------------------------
# One implementation; so/zo just choose the preferred viewer:
#   so -> sioyek first, zathura as fallback
#   zo -> zathura first, sioyek as fallback
# With a path argument the viewer opens it directly; bare, fzf picks.
# Mirrors _zsh_open_pdf in ~/.zsh/rc.d/45-openers.zsh.
_bash_open_pdf() {
  local caller="${FUNCNAME[1]:-open-pdf}"
  local prefer="$1" viewer='' v file
  local -a order
  shift

  case "$prefer" in
    zathura) order=(zathura sioyek) ;;
    *)       order=(sioyek zathura) ;;
  esac
  for v in "${order[@]}"; do
    if _have "$v"; then
      viewer="$v"
      break
    fi
  done
  [ -n "$viewer" ] || {
    echo "$caller: neither sioyek nor zathura installed" >&2
    return 127
  }

  if [ -n "$1" ]; then
    file="$1"
    [ -f "$file" ] || { echo "$caller: '$file' not found" >&2; return 1; }
  else
    _have fzf || { echo "$caller: fzf not found" >&2; return 127; }
    file="$(_bash_ls_files pdf | fzf --prompt='Open PDF> ')" || return
    [ -n "$file" ] || return 1
  fi

  case "$viewer" in
    # --new-window overrides our hxp-tuned `should_launch_new_window 0` pref so
    # ad-hoc browsing opens each PDF in its own window instead of replacing
    # the hxp preview window.
    sioyek)  nohup sioyek --new-window "$file" >/dev/null 2>&1 & ;;
    zathura) nohup zathura "$file"             >/dev/null 2>&1 & ;;
  esac
}

so() { _bash_open_pdf sioyek "$@"; }
zo() { _bash_open_pdf zathura "$@"; }

bo() {
  local file
  _have ebook-viewer || { echo "bo: ebook-viewer not found" >&2; return 127; }

  if [ -n "$1" ]; then
    file="$1"
    [ -f "$file" ] || { echo "bo: '$file' not found" >&2; return 1; }
  else
    _have fzf || { echo "bo: fzf not found" >&2; return 127; }
    file="$(_bash_ls_files epub | fzf --prompt='Open EPUB> ')" || return
    [ -n "$file" ] || return 1
  fi

  nohup ebook-viewer "$file" >/dev/null 2>&1 &
}

# --------------------------------------------------------
# Zk
# --------------------------------------------------------
# Previews use $_bash_bat (resolved above); plain `cat` takes none of bat's
# flags, so the preview command is built rather than interpolated blindly.
zn() {
  local note preview='cat -- {}'
  [ "$_bash_bat" != cat ] &&
    preview="$_bash_bat --color=always --style=header,grid --line-range :500 {}"
  note=$(zk list --format path --sort modified- --quiet | fzf \
      --prompt='Notes> ' \
      --preview "$preview" \
      --preview-window=right:50%:wrap \
      --height=80% \
      --layout=reverse \
      --header="Enter to Edit | Ctrl-C to Cancel")
  [ -n "$note" ] && hx "$note"
}

zs() {
  local note preview='cat -- {}'
  [ "$_bash_bat" != cat ] &&
    preview="$_bash_bat --color=always --style=header,numbers --line-range :500 {}"
  note=$(zk grep "$1" --format path --quiet | fzf \
      --prompt='Search Content> ' \
      --preview "$preview" \
      --preview-window=right:50%:wrap \
      --header="Search: $1")
  [ -n "$note" ] && hx "$note"
}

