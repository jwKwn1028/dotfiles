{{- $class := "desktop" -}}
{{- if hasKey . "class" -}}{{- $class = .class -}}{{- end -}}
{{- $desktopProfile := "none" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if or (eq .chezmoi.osRelease.id "linuxmint") (eq .chezmoi.osRelease.id "ubuntu") -}}
{{-     $desktopProfile = "linuxmint-i3-x11" -}}
{{-   end -}}
{{- end -}}
{{- if hasKey . "desktopProfile" -}}{{- $desktopProfile = .desktopProfile -}}{{- end -}}
{{- if and (eq .chezmoi.os "linux") (eq $class "desktop") (eq $desktopProfile "linuxmint-i3-x11") -}}
{{- $src := .packages.source.i3lock_color -}}
#!/usr/bin/env bash
# Builds the pinned i3lock-color into /usr/local; lock.sh uses stock i3lock without it.
set -euo pipefail

tag={{ $src.tag | quote }}
commit={{ $src.commit | quote }}

installed=$(/usr/local/bin/i3lock --version 2>&1 || true)
case "$installed" in
    *"version $tag "*)
        echo "  i3lock-color $tag already installed; skipping"
        exit 0
        ;;
esac

echo "==> building i3lock-color $tag (sudo may prompt for your password)"
sudo apt-get update -qq
sudo apt-get install -y --no-install-recommends \
{{- range $src.build_deps }}
    {{ . }} \
{{- end }}
    ;

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

git clone --quiet --depth 1 --branch "$tag" {{ $src.url | quote }} "$work/src"
actual=$(git -C "$work/src" rev-parse HEAD)
if [ "$actual" != "$commit" ]; then
    echo "error: i3lock-color $tag resolves to $actual, not the pinned $commit" >&2
    exit 1
fi

(cd "$work/src" && autoreconf -fi)
mkdir "$work/build"
(cd "$work/build" && "$work/src/configure" --prefix=/usr/local && make -j"$(nproc)")
sudo make -C "$work/build" install

echo "==> i3lock-color $tag installed to /usr/local/bin/i3lock"
{{- end }}
