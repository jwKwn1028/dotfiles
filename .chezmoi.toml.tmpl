{{- /* Bootstrap config template. Runs on `chezmoi init`; the answers are
       stored in ~/.config/chezmoi/chezmoi.toml (NOT in this git repo) and are
       available to every other template as .name / .email / .class / etc. */ -}}
{{- $name    := promptStringOnce . "name"  "Full name (git author)"         "" -}}
{{- $email   := promptStringOnce . "email" "Email (git author)"             "" -}}
{{- $birthdayMonthDay := promptStringOnce . "birthdayMonthDay" "Birthday [MM-DD] (blank to disable banner)" "" -}}
{{- $class   := promptStringOnce . "class" "Machine class [desktop|server]" "desktop" -}}
{{- $desktopProfileDefault := "none" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if or (eq .chezmoi.osRelease.id "linuxmint") (eq .chezmoi.osRelease.id "ubuntu") -}}
{{-     $desktopProfileDefault = "linuxmint-i3-x11" -}}
{{-   end -}}
{{- end -}}
{{- $desktopProfile := promptStringOnce . "desktopProfile" "Desktop profile [linuxmint-i3-x11|none]" $desktopProfileDefault -}}
{{- $sshRemoteUser := promptStringOnce . "sshRemoteUser" "Remote SSH username" "" -}}
{{- /* *Host = the ssh_config alias (also 50-remote.zsh.tmpl's rsync target);
       *HostName = the address it resolves to. Neither may be hardcoded. */ -}}
{{- $sshGpuHost := promptStringOnce . "sshGpuHost" "GPU SSH host alias" "" -}}
{{- $sshGpuHostName := promptStringOnce . "sshGpuHostName" "GPU hostname or IP (blank to skip)" "" -}}
{{- $sshHpcHost := promptStringOnce . "sshHpcHost" "HPC SSH host alias" "" -}}
{{- $sshHpcHostName := promptStringOnce . "sshHpcHostName" "HPC hostname or IP (blank to skip)" "" -}}
{{- /* Prompted so a local working directory stays out of the repo. */ -}}
{{- $flameshotSavePath := promptStringOnce . "flameshotSavePath" "Screenshot directory (blank for ~/Pictures)" "" -}}

[data]
    name              = {{ $name | quote }}
    email             = {{ $email | quote }}
    birthdayMonthDay  = {{ $birthdayMonthDay | quote }}
    class             = {{ $class | quote }}
    desktopProfile    = {{ $desktopProfile | quote }}
    sshRemoteUser     = {{ $sshRemoteUser | quote }}
    sshGpuHost        = {{ $sshGpuHost | quote }}
    sshGpuHostName    = {{ $sshGpuHostName | quote }}
    sshHpcHost        = {{ $sshHpcHost | quote }}
    sshHpcHostName    = {{ $sshHpcHostName | quote }}
    flameshotSavePath = {{ $flameshotSavePath | quote }}
