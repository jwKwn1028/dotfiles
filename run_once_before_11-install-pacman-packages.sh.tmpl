{{- if eq .chezmoi.os "linux" -}}
{{- $distro := .chezmoi.osRelease.id -}}
{{- if eq $distro "cachyos" -}}
#!/usr/bin/env bash
{{ $class := "desktop" -}}
{{ if hasKey . "class" }}{{ $class = .class }}{{ end -}}
{{ $desktopProfile := "cachyos-niri-noctalia" -}}
{{ if hasKey . "desktopProfile" }}{{ $desktopProfile = .desktopProfile }}{{ end -}}
# Installs CachyOS/Arch packages listed in .chezmoidata/packages.toml.
# Pacman performs a full system upgrade because partial upgrades are not
# supported on Arch-family systems.
set -euo pipefail

if ! command -v pacman >/dev/null 2>&1; then
    echo "pacman not found; skipping CachyOS provisioning."
    exit 0
fi

echo "==> pacman provisioning (machine class: {{ $class }}, profile: {{ $desktopProfile }})"
echo "    (sudo and pacman may prompt for confirmation)"

sudo pacman -Syu --needed \
{{- range .packages.pacman.common }}
    {{ . }} \
{{- end }}
    ;

{{ if and (eq $class "desktop") (eq $desktopProfile "cachyos-niri-noctalia") -}}
# Keep the CachyOS-supported Niri/Noctalia stack and install its user tools.
sudo pacman -S --needed \
{{- range .packages.pacman.niri_noctalia }}
    {{ . }} \
{{- end }}
    ;
{{- else -}}
echo "Profile is not cachyos-niri-noctalia; skipping its desktop package set."
{{- end }}

echo "==> pacman provisioning done."
{{- end }}
{{- end }}
